---
// Shared document shell: <head> meta (SEO, Open Graph, Twitter, icons,
// JSON-LD) and the global Liquid Glass tokens. Pages pass their own copy and
// add anything page-specific through the "head" slot.
import "../styles/liquid-glass.css";
import { name, siteUrl } from "../data/site";

interface Icon {
	rel: string;
	href: string;
	type?: string;
	sizes?: string;
}

interface Props {
	title: string;
	description: string;
	/** Absolute canonical URL. */
	url: string;
	ogType?: string;
	/** Absolute or root-relative OG image URL. */
	ogImage?: string;
	ogImageWidth?: number;
	ogImageHeight?: number;
	ogImageAlt?: string;
	twitterCard?: "summary" | "summary_large_image";
	icons?: Icon[];
	structuredData?: object;
	bodyClass?: string;
}

const defaultIcons: Icon[] = [
	{ rel: "icon", href: "/favicon.ico", sizes: "32x32" },
	{ rel: "icon", href: "/favicon.svg", type: "image/svg+xml" },
	{ rel: "icon", href: "/icon-192.png", type: "image/png", sizes: "192x192" },
	{ rel: "apple-touch-icon", href: "/apple-touch-icon.png" },
];

const {
	title,
	description,
	url,
	ogType = "website",
	ogImage = "/og.png",
	ogImageWidth = 1200,
	ogImageHeight = 630,
	ogImageAlt,
	twitterCard = "summary_large_image",
	icons = defaultIcons,
	structuredData,
	bodyClass,
} = Astro.props;

const ogImageUrl = new URL(ogImage, siteUrl).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={name} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="canonical" href={url} />
		<meta name="theme-color" content="#000000" />
		<meta name="color-scheme" content="dark" />
		<meta name="generator" content={Astro.generator} />

		{icons.map((icon) => <link rel={icon.rel} href={icon.href} type={icon.type} sizes={icon.sizes} />)}
		<link rel="sitemap" type="application/xml" href="/sitemap.xml" />

		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={url} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content={String(ogImageWidth)} />
		<meta property="og:image:height" content={String(ogImageHeight)} />
		{ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
		<slot name="head" />
		<meta name="twitter:card" content={twitterCard} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		{structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
	</head>
	<body class={bodyClass}>
		<slot />
	</body>
</html>
