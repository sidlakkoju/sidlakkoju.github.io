---
// Live demo of Photos Swipe in a phone frame.
//
// Contract with the demo at /photos-swipe/demo/ (same origin):
//   - Desktop (>= 700px wide and not touch-first): an inline
//     <iframe src="/photos-swipe/demo/?embed=1&top=50&scheme=dark"> rendered edge to edge
//     at 390x844 and scaled into the phone frame. It is created only once the
//     page has loaded and gone idle, and the frame is near the viewport
//     (until then the static preview shows), and its rendering is skipped
//     (content-visibility) while it's far offscreen; its state is kept.
//   - top=<pt>: the height of the status bar the page draws over the top of
//     the iframe (time, Dynamic Island, glyphs; transparent, no touches). The
//     demo pads its own header by this much so it stays clear of the island.
//     Builds that predate the param ignore it.
//   - demo -> page: postMessage({ type: "photos-swipe-demo", event: "first-swipe" })
//     hides the "Drag the photo" coach mark.
//   - demo -> page: postMessage({ type: "photos-swipe-demo", event: "escape" })
//     when Escape is pressed inside the demo with nothing of its own open;
//     the phone sheet closes on it (the iframe has focus once tapped, so the
//     <dialog> never sees the key itself). Builds before 1.2.169 don't send it.
//   - Wheel over the inline demo: the demo locks its own document, so the
//     page scrolls itself by any wheel the demo didn't use (see forwardWheel).
//   - page -> demo: postMessage({ type: "photos-swipe-demo", command: "reset" })
//     is sent when "Reset" is clicked. The demo reloads itself, so the page
//     fades the frame out, shows the coach mark again, and fades the frame
//     back in on its next load.
//   - Phones (< 700px or touch-first): the frame shows a static preview and
//     "Try the live demo" opens a full-screen sheet with
//     <iframe src="/photos-swipe/demo/?scheme=dark"> (no embed=1) and a close button. scheme=dark keeps the demo matching the dark site whatever the OS appearance.
import Icon from "./Icon.astro";
import ResponsiveImage from "./ResponsiveImage.astro";
import { links } from "../data/photos-swipe";
---

<div class="demo" data-demo data-src={links.demo}>
	<div class="demo-badge" data-inline-only data-glass="clear">
		<span class="demo-dot" aria-hidden="true"></span>
		Live demo · try it
	</div>

	<div class="phone">
		<div class="phone-screen">
			<div class="phone-status" aria-hidden="true">
				<span class="phone-time">9:41</span>
				<span class="phone-island"></span>
				<span class="phone-glyphs">
					<svg viewBox="0 0 18 12" width="18" height="12" fill="currentColor">
						<rect x="0" y="8" width="3" height="4" rx="1" />
						<rect x="5" y="5.5" width="3" height="6.5" rx="1" />
						<rect x="10" y="3" width="3" height="9" rx="1" />
						<rect x="15" y="0" width="3" height="12" rx="1" />
					</svg>
					<svg viewBox="0 0 16 12" width="16" height="12" fill="currentColor">
						<path d="M8 2.6c2.3 0 4.4.9 6 2.4l1.2-1.3A10.4 10.4 0 0 0 8 .8 10.4 10.4 0 0 0 .8 3.7L2 5c1.6-1.5 3.7-2.4 6-2.4Z" />
						<path d="M8 6.2c1.3 0 2.5.5 3.4 1.3l1.2-1.3A6.8 6.8 0 0 0 8 4.4c-1.8 0-3.4.7-4.6 1.8l1.2 1.3c.9-.8 2.1-1.3 3.4-1.3Z" />
						<path d="M8 9.6c.4 0 .8.2 1.1.4L8 11.2 6.9 10c.3-.2.7-.4 1.1-.4Z" />
					</svg>
					<svg viewBox="0 0 27 12" width="27" height="12" fill="none">
						<rect x="0.5" y="0.5" width="23" height="11" rx="3.5" stroke="currentColor" opacity="0.4" />
						<rect x="2" y="2" width="20" height="8" rx="2" fill="currentColor" />
						<path d="M25 4v4a2 2 0 0 0 0-4Z" fill="currentColor" opacity="0.4" />
					</svg>
				</span>
			</div>
			<!-- A screenshot of the demo as it opens (scripts/images.mjs preview), so
			     the inline demo fades in over the same screen (only the shuffled
			     photo differs). It's the page's LCP element on every layout:
			     fetched early, never lazy. -->
			<ResponsiveImage
				class="phone-preview"
				base="/photos-swipe/preview"
				widths={[400, 660]}
				sizes="(max-width: 699px) 200px, 330px"
				fallback="jpg"
				alt="Photos Swipe on an iPhone: a Big Sur sunset photo card with Trash and Keep buttons."
				width="390"
				height="844"
				fetchpriority="high"
				decoding="async"
			/>
			<div class="phone-iframe-host" data-iframe-host></div>
			<div class="coach" data-coach aria-hidden="true" data-glass="clear">
				<Icon name="swipe" size={14} />
				Drag the photo
			</div>
		</div>
	</div>

	<div class="demo-footer" data-inline-only>
		<span>Sample photos · nothing leaves this page</span>
		<button type="button" class="demo-reset lg-focusable" data-reset>Reset</button>
	</div>

	<div class="demo-sheet-cta" data-sheet-only>
		<button type="button" class="lg-button lg-button--primary lg-button--small" data-open-sheet>
			<Icon name="expand" size={17} />
			Try the live demo
		</button>
		<span class="lg-caption demo-sheet-caption">Opens full screen · sample photos</span>
	</div>

	<dialog class="demo-sheet" data-sheet aria-labelledby="demo-sheet-title" tabindex="-1">
		<header class="demo-sheet-bar">
			<span class="demo-dot" aria-hidden="true"></span>
			<span id="demo-sheet-title" class="demo-sheet-title">Live demo · sample photos</span>
			<button type="button" class="demo-sheet-close lg-icon-button" data-close-sheet aria-label="Close demo" data-glass="clear">
				<Icon name="close" size={18} />
			</button>
		</header>
		<div class="demo-sheet-host" data-sheet-host></div>
	</dialog>
</div>

<script>
	const MESSAGE_TYPE = "photos-swipe-demo";
	// Status bar height in 390pt screen units; matches .phone-status.
	const STATUS_TOP = 50;
	const SHEET_MQ = "(max-width: 699px), (hover: none) and (pointer: coarse)";

	for (const root of document.querySelectorAll<HTMLElement>("[data-demo]")) {
		const src = root.dataset.src!;
		const host = root.querySelector<HTMLElement>("[data-iframe-host]")!;
		const coach = root.querySelector<HTMLElement>("[data-coach]")!;
		const sheet = root.querySelector<HTMLDialogElement>("[data-sheet]")!;
		const sheetHost = root.querySelector<HTMLElement>("[data-sheet-host]")!;
		const sheetMQ = window.matchMedia(SHEET_MQ);
		let inline: HTMLIFrameElement | null = null;
		let near = false;
		// The inline demo (~330 KB of script, run in this page's process)
		// waits for the page to load and go idle, so it never competes with
		// first paint or the preview image. The preview is a screenshot of
		// the demo's first screen, so the swap is barely visible.
		let pageReady = false;

		function makeFrame(url: string, title: string) {
			const f = document.createElement("iframe");
			f.src = url;
			f.title = title;
			f.allow = "fullscreen";
			f.setAttribute("allowtransparency", "true");
			return f;
		}

		// The demo locks its own document, so a wheel over the inline frame
		// never chains to the page. Scroll the page by any vertical wheel the
		// demo didn't use: it only takes the wheel while a photo is enlarged
		// or a panel inside it can still scroll that way.
		function forwardWheel(frame: HTMLIFrameElement) {
			const w = frame.contentWindow as (Window & typeof globalThis) | null;
			if (!w) return;
			w.addEventListener(
				"wheel",
				(e: WheelEvent) => {
					if (e.ctrlKey) return;
					const unit = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? window.innerHeight : 1;
					const dy = e.deltaY * unit;
					if (Math.abs(dy) <= Math.abs(e.deltaX * unit)) return;
					for (const node of e.composedPath()) {
						if (!(node instanceof w.HTMLElement) || node.scrollHeight <= node.clientHeight + 1) continue;
						const overflow = w.getComputedStyle(node).overflowY;
						if (overflow !== "auto" && overflow !== "scroll") continue;
						if (dy < 0 ? node.scrollTop > 0 : node.scrollTop + node.clientHeight < node.scrollHeight - 1) return;
					}
					// The demo stops the wheel from bubbling, so this listens in the
					// capture phase and decides once the event has been dispatched.
					setTimeout(() => {
						if (!e.defaultPrevented) window.scrollBy(0, dy);
					});
				},
				{ capture: true, passive: true },
			);
		}
		
		// Inline demo: only on desktop, and only once the frame is near view.
		function syncInline() {
			const want = near && pageReady && !sheetMQ.matches;
			root.classList.toggle("is-inline", !sheetMQ.matches);
			if (want && !inline) {
				inline = makeFrame(`${src}?embed=1&top=${STATUS_TOP}&scheme=dark`, "Photos Swipe live demo");
				const frame = inline;
				frame.addEventListener("load", () => {
					root.classList.add("is-loaded");
					forwardWheel(frame);
				});
				host.append(inline);
			} else if (!want && inline && sheetMQ.matches) {
				inline.remove();
				inline = null;
				root.classList.remove("is-loaded");
			}
		}

		new IntersectionObserver(
			(entries) => {
				const isNear = entries[0].isIntersecting;
				// Far offscreen: skip the demo's rendering (rAF, paint) but keep
				// its state. Safari already throttles offscreen iframes; Chrome
				// doesn't for same-origin ones, but honours content-visibility.
				root.classList.toggle("is-parked", !isNear);
				if (isNear) {
					near = true;
					syncInline();
				}
			},
			{ rootMargin: "400px 0px" },
		).observe(root);
		sheetMQ.addEventListener("change", syncInline);
		syncInline();
		const ready = () => {
			const go = () => {
				pageReady = true;
				syncInline();
			};
			if ("requestIdleCallback" in window) requestIdleCallback(go, { timeout: 1500 });
			else setTimeout(go, 100);
		};
		if (document.readyState === "complete") ready();
		else window.addEventListener("load", ready, { once: true });

		window.addEventListener("message", (e) => {
			const data = e.data;
			if (e.origin !== location.origin || !data || data.type !== MESSAGE_TYPE) return;
			if (inline && e.source === inline.contentWindow && data.event === "first-swipe") coach.classList.add("is-hidden");
			const sheetFrame = sheetHost.querySelector("iframe");
			if (sheet.open && sheetFrame && e.source === sheetFrame.contentWindow && data.event === "escape") sheet.close();
		});

		root.querySelector("[data-reset]")!.addEventListener("click", () => {
			if (!inline?.contentWindow) return;
			// The demo reloads: fade it out, bring the coach mark back, and let
			// the frame's next load fade it in again.
			root.classList.remove("is-loaded");
			coach.classList.remove("is-hidden");
			inline.contentWindow.postMessage({ type: MESSAGE_TYPE, command: "reset" }, location.origin);
		});

		// Full-screen sheet for phones. Once it has slid up it covers the
		// page completely, so the page stops painting underneath it.
		const html = document.documentElement;
		const cover = () => sheet.open && html.classList.add("sheet-covered");
		sheet.addEventListener("animationend", (e) => e.target === sheet && cover());
		root.querySelector("[data-open-sheet]")!.addEventListener("click", () => {
			// The demo is created after the sheet's first frame, so the tap
			// answers at once and the slide-up starts before the demo's
			// script is parsed.
			if (!sheetHost.firstChild) {
				requestAnimationFrame(() =>
					setTimeout(() => {
						if (sheet.open && !sheetHost.firstChild) sheetHost.append(makeFrame(`${src}?scheme=dark`, "Photos Swipe live demo"));
					}),
				);
			}
			sheet.showModal();
			// Focus the sheet itself: a ring on the close button the moment it
			// opens reads as a selected control.
			sheet.focus();
			html.classList.add("sheet-open");
			if (!sheet.getAnimations().length) cover();
		});
		root.querySelector("[data-close-sheet]")!.addEventListener("click", () => sheet.close());
		sheet.addEventListener("close", () => {
			html.classList.remove("sheet-open", "sheet-covered");
			// Drop the demo so it starts fresh (and stops running) next time.
			sheetHost.replaceChildren();
		});
	}
</script>

<style>
	.demo {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 18px;
	}
	.demo-badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 36px;
		padding: 0 15px 0 13px;
		border-radius: var(--lg-radius-pill);
		font-size: 15px;
		font-weight: 500;
		line-height: 20px;
		letter-spacing: -0.2px;
	}
	.demo-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--lg-accent-green);
		box-shadow: 0 0 8px rgba(48, 209, 88, 0.8);
	}

	/* ---- Phone frame: a 390x844 screen scaled by --phone-scale ---- */
	.phone {
		--phone-scale: 0.846;
		--bezel: 10px;
		position: relative;
		box-sizing: content-box;
		width: calc(390px * var(--phone-scale));
		height: calc(844px * var(--phone-scale));
		padding: var(--bezel);
		border-radius: calc(56px * var(--phone-scale) + var(--bezel));
		background: #0b0b0d;
		box-shadow:
			inset 0 0 0 1px rgba(255, 255, 255, 0.22),
			inset 0 0 0 3px #1c1c20,
			0 30px 80px rgba(0, 0, 0, 0.55),
			0 0 0 1px rgba(255, 255, 255, 0.04);
	}
	.phone-screen {
		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
		border-radius: calc(56px * var(--phone-scale));
		background: #1a1210;
		/* Contain the iframe's own compositing so the rounded clip holds. */
		isolation: isolate;
	}
	/* Status bar: 390x50pt, scaled like the iframe, drawn over the top of the
	   edge-to-edge screen. Transparent and click-through; the demo keeps its
	   header clear of it via ?top=50. */
	.phone-status {
		--status-h: 50px;
		position: absolute;
		top: 0;
		left: 0;
		z-index: 2;
		display: grid;
		grid-template-columns: 1fr 110px 1fr;
		align-items: center;
		justify-items: center;
		box-sizing: border-box;
		width: 390px;
		height: var(--status-h);
		padding: 0 14px 0 20px;
		color: #fff;
		transform: scale(var(--phone-scale));
		transform-origin: 0 0;
		pointer-events: none;
	}
	.phone-time {
		font: 600 17px/22px var(--lg-font-text);
		letter-spacing: -0.4px;
		font-variant-numeric: tabular-nums;
		text-shadow: 0 0 3px rgba(0, 0, 0, 0.3);
	}
	.phone-island {
		width: 110px;
		height: 32px;
		border-radius: 999px;
		background: #000;
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
	}
	.phone-glyphs {
		display: flex;
		align-items: center;
		gap: 6px;
	}
	.phone-glyphs svg {
		display: block;
		filter: drop-shadow(0 0 1.5px rgba(0, 0, 0, 0.3));
	}
	/* A full 390x844 capture with its status bar left empty for the overlay. */
	.phone-preview {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.phone-iframe-host {
		position: absolute;
		top: 0;
		left: 0;
		width: 390px;
		height: 844px;
		transform: scale(var(--phone-scale));
		transform-origin: 0 0;
	}
	.is-parked .phone-iframe-host {
		content-visibility: hidden;
	}
	.phone-iframe-host :global(iframe) {
		display: block;
		width: 390px;
		height: 844px;
		border: 0;
		background: transparent;
		opacity: 0;
		transition: opacity 0.4s ease;
	}
	.is-loaded .phone-iframe-host :global(iframe) {
		opacity: 1;
	}
	.coach {
		position: absolute;
		left: 50%;
		top: 60%;
		display: none;
		align-items: center;
		gap: 6px;
		height: 32px;
		padding: 0 12px;
		border-radius: var(--lg-radius-pill);
		font-size: 13px;
		font-weight: 500;
		line-height: 17px;
		white-space: nowrap;
		transform: translateX(-50%);
		pointer-events: none;
		transition: opacity 0.3s ease, transform 0.3s ease;
	}
	.is-inline .coach {
		display: inline-flex;
	}
	.coach.is-hidden {
		opacity: 0;
		transform: translate(-50%, 6px);
	}
	@media (prefers-reduced-motion: no-preference) {
		.is-inline .coach:not(.is-hidden) {
			animation: coach-nudge 2.4s ease-in-out 5;
		}
	}
	/* A moving refracting element re-runs its SVG filter every frame on
	   Chromium's main thread (~7% of a core here), so the nudge plays five
	   times, not forever, and pauses while the demo is far offscreen. */
	.demo.is-parked .coach {
		animation-play-state: paused;
	}
	@keyframes coach-nudge {
		0%, 100% {
			translate: 0 0;
		}
		50% {
			translate: 6px 0;
		}
	}

	.demo-footer {
		display: flex;
		align-items: baseline;
		gap: 16px;
		font-size: 13px;
		line-height: 18px;
		color: var(--lg-label-tertiary);
	}
	.demo-reset {
		padding: 0;
		border: 0;
		background: none;
		color: var(--lg-accent-blue);
		font: inherit;
		cursor: pointer;
		border-radius: 4px;
	}
	@media (hover: hover) {
		.demo-reset:hover {
			text-decoration: underline;
		}
	}
	.demo-reset:active {
		opacity: 0.6;
	}

	.demo-sheet-cta {
		display: none;
		flex-direction: column;
		align-items: center;
		gap: 16px;
	}
	.demo-sheet-caption {
		color: var(--lg-label-tertiary);
	}

	/* Inline vs sheet presentation. */
	.demo:not(.is-inline) [data-inline-only] {
		display: none;
	}
	.demo:not(.is-inline) .demo-sheet-cta {
		display: flex;
	}
	@media (max-width: 699px), (hover: none) and (pointer: coarse) {
		.demo [data-inline-only] {
			display: none;
		}
		.demo .demo-sheet-cta {
			display: flex;
		}
	}

	/* ---- Full-screen sheet ---- */
	.demo-sheet {
		width: 100%;
		max-width: none;
		height: 100%;
		height: 100dvh;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: #000;
		color: var(--lg-label);
	}
	.demo-sheet:focus {
		outline: none;
	}
	.demo-sheet::backdrop {
		background: rgba(0, 0, 0, 0.6);
	}
	.demo-sheet[open] {
		animation: sheet-up 0.45s var(--lg-ease-spring);
	}
	@keyframes sheet-up {
		from {
			transform: translateY(40px);
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.demo-sheet[open] {
			animation: none;
		}
	}
	.demo-sheet[open] {
		display: flex;
		flex-direction: column;
	}
	.demo-sheet-bar {
		display: flex;
		align-items: center;
		gap: 8px;
		box-sizing: border-box;
		min-height: 52px;
		padding: var(--lg-safe-top) max(12px, var(--lg-safe-right)) 0 max(16px, var(--lg-safe-left));
		padding-top: max(6px, var(--lg-safe-top));
		padding-bottom: 6px;
		flex: none;
	}
	.demo-sheet-title {
		flex: 1;
		font-size: 15px;
		font-weight: 600;
		line-height: 20px;
		letter-spacing: -0.2px;
	}
	.demo-sheet-close {
		flex: none;
	}
	.demo-sheet-host {
		flex: 1;
		min-height: 0;
	}
	.demo-sheet-host :global(iframe) {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}
	:global(html.sheet-open) {
		overflow: hidden;
	}
	:global(html.sheet-covered body) {
		visibility: hidden;
	}
	.demo-sheet {
		visibility: visible;
	}
</style>
