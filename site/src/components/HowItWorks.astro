---
// "How it works" animated diagram (Figma component 15:996, storyboard 16:691).
// All copy comes from src/data/photos-swipe.ts; geometry lives here.
import Icon from "./Icon.astro";
import { diagram, type NodeId, type LabelId, type RouteId } from "../data/photos-swipe";

const { nodes, labels, steps } = diagram;
const first = steps[0];

// ---- Desktop geometry (1200x600 stage) -----------------------------------
const nodeBox: Record<NodeId, { x: number; y: number; w: number; h: number }> = {
	userscript: { x: 80, y: 150, w: 360, h: 110 },
	storage: { x: 80, y: 410, w: 360, h: 96 },
	api: { x: 760, y: 70, w: 400, h: 88 },
	media: { x: 760, y: 186, w: 400, h: 88 },
	trash: { x: 760, y: 302, w: 400, h: 88 },
	worker: { x: 760, y: 456, w: 400, h: 88 },
};

// Wire segments. A route lights up its segments and carries the packets.
const segments = {
	bus: "M440 205H660",
	spApi: "M660 205V114",
	brApi: "M660 114H760",
	spMedia: "M660 205V230",
	brMedia: "M660 230H760",
	spTrash: "M660 205V346",
	brTrash: "M660 346H760",
	spWorker: "M660 205V500",
	brWorker: "M660 500H760",
	local: "M260 260V410",
};
type SegmentId = keyof typeof segments;
const dashedSegments: SegmentId[] = ["brWorker"];

const routes: Record<RouteId, { path: string; segments: SegmentId[] }> = {
	toApi: { path: "M440 205H660V114H760", segments: ["bus", "spApi", "brApi"] },
	toMedia: { path: "M440 205H660V230H760", segments: ["bus", "spMedia", "brMedia"] },
	toTrash: { path: "M440 205H660V346H760", segments: ["bus", "spTrash", "brTrash"] },
	toWorker: { path: "M440 205H660V500H760", segments: ["bus", "spWorker", "brWorker"] },
	toStorage: { path: "M260 260V410", segments: ["local"] },
};

// Wire-label pills: `left` or `right` (distance from the stage's right edge).
const labelPos: Record<LabelId, { left?: number; right?: number; top: number }> = {
	libraryPage: { right: 552, top: 96 },
	moveBatch: { right: 552, top: 96 },
	upcomingPreviews: { right: 552, top: 218 },
	verify: { right: 552, top: 333 },
	keepTrash: { left: 272, top: 318 },
	idsDecisions: { right: 552, top: 468 },
	appCode: { left: 676, top: 522 },
};

// Packet tracks as polylines, parsed from the M/H/V route paths above. The
// client turns them into compositor-only transform keyframes once per step.
const toPoints = (d: string) => {
	const pts: [number, number][] = [];
	let x = 0;
	let y = 0;
	for (const [, cmd, n] of d.matchAll(/([MHV])\s*([-\d.]+(?:[\s,]+[-\d.]+)?)/g)) {
		const v = n.split(/[\s,]+/).map(Number);
		if (cmd === "M") [x, y] = v;
		else if (cmd === "H") x = v[0];
		else y = v[0];
		pts.push([x, y]);
	}
	return pts;
};
const routePoints = Object.fromEntries((Object.keys(routes) as RouteId[]).map((id) => [id, toPoints(routes[id].path)]));

// ---- Phone mapping ------------------------------------------------------
// Three wires: inside the tab (local), tab -> Google (google), and a lane
// down the right edge that skips the Google group, tab -> Worker (worker).
const mobileWires: Record<RouteId, string[]> = {
	toApi: ["google"],
	toMedia: ["google"],
	toTrash: ["google"],
	toWorker: ["worker"],
	toStorage: ["local"],
};
const mobileLabelWire: Record<LabelId, string> = {
	libraryPage: "google",
	upcomingPreviews: "google",
	moveBatch: "google",
	verify: "google",
	keepTrash: "local",
	idsDecisions: "worker",
	appCode: "worker",
};
const labelsFor = (wire: string) => (Object.keys(labels) as LabelId[]).filter((l) => mobileLabelWire[l] === wire);

// Everything the client script needs, derived from the data above.
const clientSteps = steps.map((s) => {
	const wires = new Map<string, "out" | "in">();
	for (const r of s.routes) for (const w of mobileWires[r.id]) if (!wires.has(w)) wires.set(w, r.dir);
	return {
		id: s.id,
		title: s.title,
		caption: s.caption,
		captionShort: s.captionShort,
		active: s.active,
		labels: s.labels,
		routes: s.routes.map((r) => ({ id: r.id, dir: r.dir })),
		segments: [...new Set(s.routes.flatMap((r) => routes[r.id].segments))],
		mobileWires: [...wires].map(([id, dir]) => ({ id, dir })),
	};
});

const glyphIcon = (glyph: string) => glyph as "hard-drive" | "braces" | "download" | "trash" | "sync";
const isActive = (id: NodeId) => first.active.includes(id);
---

<section class="hiw" id="how-it-works" aria-labelledby="hiw-title">
	<h2 id="hiw-title" class="hiw-title">{diagram.heading}</h2>
	<p class="hiw-sub">{diagram.subheading}</p>

	<div
		class="hiw-diagram"
		data-hiw
		data-step={first.id}
		data-steps={JSON.stringify(clientSteps)}
		data-routes={JSON.stringify(routePoints)}
	>
		<!-- Desktop: one 1200x600 stage, scaled to fit. -->
		<div class="hiw-frame">
			<div class="hiw-stage">
				<svg class="hiw-wires" viewBox="0 0 1200 600" aria-hidden="true">
					<rect class="hiw-group" x="740.5" y="52.5" width="439" height="351" rx="24" />
					<!-- Neutral wiring -->
					<path class="hiw-wire" d="M440 205H660M660 114V500M660 114H760M660 230H760M660 346H760M260 260V410" />
					<path class="hiw-wire hiw-wire--dashed" d="M660 500H760" />
					<path class="hiw-appcode" class:list={[first.labels.includes("appCode") && "is-shown"]} d="M760 513H669V214H440" />
					<!-- Active overlays -->
					{
						(Object.keys(segments) as SegmentId[]).map((id) => (
							<path
								class:list={["hiw-seg", dashedSegments.includes(id) && "hiw-seg--dashed"]}
								data-seg={id}
								d={segments[id]}
							/>
						))
					}
				</svg>
				<!-- Packets: HTML dots moved by transform keyframes (compositor only). -->
				<div class="hiw-packets" aria-hidden="true"></div>

				<div class="hiw-tab">
					<span class="hiw-dots" aria-hidden="true"><i></i><i></i><i></i></span>
					<span class="hiw-tab-label">{diagram.tabLabel}</span>
				</div>
				<span class="hiw-eyebrow lg-eyebrow" style="top: 30px">{diagram.groupLabel}</span>
				<span class="hiw-eyebrow lg-eyebrow" style="top: 434px">{diagram.optionalLabel}</span>

				{
					(Object.keys(nodes) as NodeId[]).map((id) => {
						const n = nodes[id];
						const b = nodeBox[id];
						return (
							<div
								class:list={["hiw-node", `hiw-node--${id}`, isActive(id) && "is-active"]}
								data-node={id}
								style={`left:${b.x}px;top:${b.y}px;width:${b.w}px;height:${b.h}px`}
							>
								{n.glyph === "app" ? (
									<img class="hiw-appicon" src="/photos-swipe/icon.png" alt="" width="52" height="52" />
								) : (
									<span class="hiw-glyph">
										<Icon name={glyphIcon(n.glyph)} size={22} />
									</span>
								)}
								<span class="hiw-node-text">
									<span class="hiw-node-title">{n.title}</span>
									<span class="hiw-node-sub">{n.sub}</span>
								</span>
							</div>
						);
					})
				}

				{
					(Object.keys(labels) as LabelId[]).map((id) => {
						const p = labelPos[id];
						const pos = p.left != null ? `left:${p.left}px` : `right:${p.right}px`;
						return (
							<span
								class:list={["hiw-label", first.labels.includes(id) && "is-shown"]}
								data-label={id}
								style={`${pos};top:${p.top}px`}
							>
								{labels[id]}
							</span>
						);
					})
				}
			</div>
		</div>

		<!--
			Phones: one-line rows (the active ones add their subtitle, so the
			height never changes), wires down the icon column with their labels
			beside them, and the Worker on its own lane down the right edge.
		-->
		<div class="hiw-m">
			<div class="hiw-m-tab">
				<div class="hiw-m-tabhead">
					<span class="hiw-dots" aria-hidden="true"><i></i><i></i><i></i></span>
					<span class="hiw-tab-label">{diagram.tabLabelShort}</span>
				</div>
				{
					(["userscript", "local", "storage"] as const).map((item) =>
						item === "local" ? (
							<div class="hiw-m-wire hiw-m-wire--local" data-wire="local">
								<span class="hiw-m-line" aria-hidden="true">
									<i class="pk" />
									<i class="pk" />
								</span>
								<span class="hiw-m-labels">
									{labelsFor("local").map((l) => (
										<span class:list={["hiw-label", first.labels.includes(l) && "is-shown"]} data-label={l}>
											{labels[l]}
										</span>
									))}
								</span>
							</div>
						) : (
							<div class:list={["hiw-m-node", isActive(item) && "is-active"]} data-node={item}>
								{nodes[item].glyph === "app" ? (
									<img class="hiw-m-icon" src="/photos-swipe/icon.png" alt="" width="32" height="32" />
								) : (
									<span class="hiw-m-icon">
										<Icon name={glyphIcon(nodes[item].glyph)} size={17} />
									</span>
								)}
								<span class="hiw-m-text">
									<span class="hiw-m-title">{nodes[item].title}</span>
									<span class="hiw-m-sub">{nodes[item].subShort}</span>
								</span>
							</div>
						),
					)
				}
			</div>

			<div class="hiw-m-wire hiw-m-wire--google" data-wire="google">
				<span class="hiw-m-line" aria-hidden="true">
					<i class="pk" />
					<i class="pk" />
				</span>
				<span class="hiw-m-labels">
					{labelsFor("google").map((l) => (
						<span class:list={["hiw-label", first.labels.includes(l) && "is-shown"]} data-label={l}>
							{labels[l]}
						</span>
					))}
				</span>
			</div>

			<div class="hiw-m-group">
				<span class="lg-eyebrow">{diagram.groupLabel}</span>
				{
					(["api", "media", "trash"] as const).map((id) => (
						<div class:list={["hiw-m-node", isActive(id) && "is-active"]} data-node={id}>
							<span class="hiw-m-icon">
								<Icon name={glyphIcon(nodes[id].glyph)} size={17} />
							</span>
							<span class="hiw-m-text">
								<span class="hiw-m-title">{nodes[id].title}</span>
								<span class="hiw-m-sub">{nodes[id].subShort}</span>
							</span>
						</div>
					))
				}
			</div>

			<div class="hiw-m-labels hiw-m-labels--worker">
				{labelsFor("worker").map((l) => (
					<span class:list={["hiw-label", first.labels.includes(l) && "is-shown"]} data-label={l}>
						{labels[l]}
					</span>
				))}
			</div>

			<div class="hiw-m-wire hiw-m-wire--lane" data-wire="worker">
				<span class="hiw-m-line" aria-hidden="true">
					<i class="pk" />
					<i class="pk" />
				</span>
			</div>

			<div class:list={["hiw-m-node", "hiw-m-node--worker", isActive("worker") && "is-active"]} data-node="worker">
				<span class="hiw-m-icon">
					<Icon name="sync" size={17} />
				</span>
				<span class="hiw-m-text">
					<span class="hiw-m-title">{nodes.worker.title}</span>
					<span class="hiw-m-sub">{nodes.worker.subShort}</span>
				</span>
			</div>
		</div>
	</div>

	<div class="hiw-chips" role="group" aria-label="How it works steps">
		{
			steps.map((s, i) => (
				<button
					type="button"
					class="lg-chip hiw-chip"
					data-index={i}
					aria-pressed={i === 0 ? "true" : "false"}
					aria-controls="hiw-caption"
					tabindex={i === 0 ? 0 : -1}
				>
					<span class="hiw-chip-track" aria-hidden="true">
							<span class="hiw-chip-progress" />
						</span>
					<span class="hiw-chip-label">{s.chip}</span>
					<span class="hiw-chip-short">
						{s.chipShort || (
							<Fragment>
								<Icon name="workflow" size={18} />
								<span class="lg-visually-hidden">{s.chip}</span>
							</Fragment>
						)}
					</span>
				</button>
			))
		}
	</div>
	<p class="hiw-caption" id="hiw-caption" aria-live="polite">
		<span class="lg-visually-hidden" data-caption-title>{first.title}: </span>
		<span class="hiw-caption-long" data-caption-text>{first.caption}</span>
		<span class="hiw-caption-short" data-caption-short>{first.captionShort}</span>
	</p>
	<p class="hiw-footnote">{diagram.footnote}</p>
</section>

<script>
	type Step = {
		id: string;
		title: string;
		caption: string;
		captionShort: string;
		active: string[];
		labels: string[];
		routes: { id: string; dir: "out" | "in" }[];
		segments: string[];
		mobileWires: { id: string; dir: "out" | "in" }[];
	};
	type Point = [number, number];

	const STEP_MS = 3600;
	const STEP_MAX_MS = 7000;
	const OVERVIEW_MS = 2500;
	const READ_BASE_MS = 1200;
	const READ_WORD_MS = 240;
	const PACKET_MS = 900;
	const PACKET_GAP = 250;
	const PACKET_CYCLE = 1600;
	const PACKETS_PER_ROUTE = 3;

	// easeInOutCubic, as before; baked into the keyframes below.
	const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);
	const unease = (u: number) => {
		let lo = 0;
		let hi = 1;
		for (let i = 0; i < 24; i++) {
			const mid = (lo + hi) / 2;
			if (ease(mid) < u) lo = mid;
			else hi = mid;
		}
		return (lo + hi) / 2;
	};

	// One packet cycle as transform keyframes: move along the polyline for
	// PACKET_MS (eased, with exact keyframes at every corner), then hide.
	function packetKeyframes(pts: Point[], dir: "out" | "in"): Keyframe[] {
		const lens = pts.slice(1).map((p, i) => Math.hypot(p[0] - pts[i][0], p[1] - pts[i][1]));
		const total = lens.reduce((a, b) => a + b, 0);
		const at = (d: number): Point => {
			for (let i = 0; i < lens.length; i++) {
				if (d <= lens[i] || i === lens.length - 1) {
					const f = lens[i] ? Math.min(1, d / lens[i]) : 0;
					return [pts[i][0] + (pts[i + 1][0] - pts[i][0]) * f, pts[i][1] + (pts[i + 1][1] - pts[i][1]) * f];
				}
				d -= lens[i];
			}
			return pts[pts.length - 1];
		};
		const times = new Set<number>();
		for (let i = 0; i <= 24; i++) times.add(i / 24);
		let run = 0;
		for (const l of lens.slice(0, -1)) {
			run += l;
			const u = run / total;
			times.add(unease(dir === "out" ? u : 1 - u));
		}
		const m = PACKET_MS / PACKET_CYCLE;
		const frames: Keyframe[] = [...times]
			.sort((a, b) => a - b)
			.map((t) => {
				const f = ease(t);
				const [x, y] = at(total * (dir === "out" ? f : 1 - f));
				return { offset: t * m, transform: `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px)`, opacity: 1 };
			});
		const end = frames[frames.length - 1].transform;
		frames.push({ offset: m + 0.001, transform: end, opacity: 0 }, { offset: 1, transform: end, opacity: 0 });
		return frames;
	}

	for (const root of document.querySelectorAll<HTMLElement>("[data-hiw]")) {
		const section = root.closest("section")!;
		const steps: Step[] = JSON.parse(root.dataset.steps!);
		const routePoints: Record<string, Point[]> = JSON.parse(root.dataset.routes!);
		const chips = [...section.querySelectorAll<HTMLButtonElement>(".hiw-chip")];
		const captionTitle = section.querySelector<HTMLElement>("[data-caption-title]")!;
		const captionText = section.querySelector<HTMLElement>("[data-caption-text]")!;
		const captionShort = section.querySelector<HTMLElement>("[data-caption-short]")!;
		const frame = root.querySelector<HTMLElement>(".hiw-frame")!;
		const packetLayer = root.querySelector<HTMLElement>(".hiw-packets")!;
		const appCode = root.querySelector<SVGPathElement>(".hiw-appcode")!;
		const nodeEls = [...root.querySelectorAll<HTMLElement>("[data-node]")];
		const segEls = [...root.querySelectorAll<SVGPathElement>("[data-seg]")];
		const labelEls = [...root.querySelectorAll<HTMLElement>("[data-label]")];
		const wireEls = [...root.querySelectorAll<HTMLElement>("[data-wire]")];

		const reduceMQ = window.matchMedia("(prefers-reduced-motion: reduce)");
		const desktopMQ = window.matchMedia("(min-width: 760px)");
		let index = 0;
		let autoplay = !reduceMQ.matches;
		let inView = false;
		let timer = 0;
		let remaining = OVERVIEW_MS;
		let scheduledAt = 0;
		let progress: Animation | null = null;
		// Pace by the caption that's actually on screen.
		const dwell = (i: number) => {
			if (i === 0) return OVERVIEW_MS;
			const caption = desktopMQ.matches ? steps[i].caption : steps[i].captionShort;
			const words = `${steps[i].title} ${caption}`.trim().split(/\s+/).length;
			return Math.min(STEP_MAX_MS, Math.max(STEP_MS, READ_BASE_MS + words * READ_WORD_MS));
		};

		// ---- Scale the 1200x600 stage to the frame width ----
		const fit = () => {
			const w = frame.clientWidth;
			if (w > 0) frame.style.setProperty("--hiw-scale", String(Math.min(1, w / 1200)));
		};
		new ResizeObserver(fit).observe(frame);
		fit();

		// ---- Steps ----
		function show(i: number) {
			index = (i + steps.length) % steps.length;
			const s = steps[index];
			root.dataset.step = s.id;
			for (const el of nodeEls) el.classList.toggle("is-active", s.active.includes(el.dataset.node!));
			for (const el of segEls) el.classList.toggle("is-active", s.segments.includes(el.dataset.seg!));
			for (const el of labelEls) el.classList.toggle("is-shown", s.labels.includes(el.dataset.label!));
			appCode.classList.toggle("is-shown", s.labels.includes("appCode"));
			for (const el of wireEls) {
				const w = s.mobileWires.find((m) => m.id === el.dataset.wire);
				el.classList.toggle("is-active", !!w);
				el.classList.toggle("dir-in", w?.dir === "in");
			}
			chips.forEach((c, j) => {
				c.setAttribute("aria-pressed", String(j === index));
				c.tabIndex = j === index ? 0 : -1;
			});
			captionTitle.textContent = `${s.title}: `;
			captionText.textContent = s.caption;
			captionShort.textContent = s.captionShort;
			buildPackets();
		}

		function startAutoplay() {
			stopAutoplay();
			if (!autoplay || !inView || document.hidden) return;
			scheduledAt = performance.now();
			timer = window.setTimeout(() => {
				timer = 0;
				show(index + 1);
				remaining = dwell(index);
				startAutoplay();
			}, remaining);
			const bar = chips[index].querySelector<HTMLElement>(".hiw-chip-progress");
			progress = bar?.animate(
				[{ transform: `scaleX(${(1 - remaining / dwell(index)).toFixed(3)})` }, { transform: "scaleX(1)" }],
				{ duration: remaining, easing: "linear", fill: "forwards" },
			) ?? null;
		}
		function pauseAutoplay() {
			if (timer) remaining = Math.max(0, remaining - (performance.now() - scheduledAt));
			stopAutoplay();
		}
		function stopAutoplay() {
			window.clearTimeout(timer);
			timer = 0;
			progress?.cancel();
			progress = null;
		}
		document.addEventListener("visibilitychange", () => (document.hidden ? pauseAutoplay() : startAutoplay()));

		chips.forEach((chip, j) => {
			chip.addEventListener("click", () => {
				autoplay = false;
				stopAutoplay();
				show(j);
			});
		});
		section.querySelector(".hiw-chips")!.addEventListener("keydown", (e) => {
			const key = (e as KeyboardEvent).key;
			const next =
				key === "ArrowRight" || key === "ArrowDown" ? index + 1
				: key === "ArrowLeft" || key === "ArrowUp" ? index - 1
				: key === "Home" ? 0
				: key === "End" ? steps.length - 1
				: null;
			if (next === null) return;
			e.preventDefault();
			autoplay = false;
			stopAutoplay();
			show(next);
			chips[index].focus();
		});

		// ---- Desktop packets ----
		// Built once per step as Web Animations on transform/opacity, so they
		// run on the compositor: no per-frame script, layout or SVG repaint.
		// Phones use CSS packets on the stacked wires instead.
		let packets: Animation[] = [];
		function buildPackets() {
			for (const a of packets) a.cancel();
			packets = [];
			packetLayer.replaceChildren();
			if (reduceMQ.matches || !desktopMQ.matches) return;
			for (const r of steps[index].routes) {
				const pts = routePoints[r.id];
				if (!pts) continue;
				const frames = packetKeyframes(pts, r.dir);
				for (let k = 0; k < PACKETS_PER_ROUTE; k++) {
					const el = document.createElement("i");
					el.className = "hiw-packet";
					packetLayer.append(el);
					const a = el.animate(frames, { duration: PACKET_CYCLE, delay: k * PACKET_GAP, iterations: Infinity });
					if (!inView) a.pause();
					packets.push(a);
				}
			}
		}

		// ---- Visibility ----
		new IntersectionObserver(
			(entries) => {
				inView = entries[0].isIntersecting;
				root.classList.toggle("in-view", inView);
				for (const a of packets) inView ? a.play() : a.pause();
				if (inView) startAutoplay();
				else pauseAutoplay();
			},
			{ threshold: 0, rootMargin: "0px 0px -20% 0px" },
		).observe(root);

		desktopMQ.addEventListener("change", buildPackets);
		reduceMQ.addEventListener("change", () => {
			if (reduceMQ.matches) {
				autoplay = false;
				stopAutoplay();
			}
			buildPackets();
		});

		show(0);
	}
