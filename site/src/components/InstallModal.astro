---
// Install guide for Photos Swipe, opened by every link marked
// [data-install-open]. Those links point at the .user.js file, so without JS
// (or with a modified click) they still install directly.
//
// Geometry: every rounded element near a rounded container's corner is
// concentric with it (radius = container radius - inset, equal x/y inset):
//   sheet 40 / padding 20  -> close button 40px circle at 20,20
//   step card 32 / padding 16 -> step number 32px circle, chips and pills
//     32px tall (r16), full-width buttons and callouts r16, all at inset 16
import Icon from "./Icon.astro";
import { installGuide as g, links } from "../data/photos-swipe";

const hintFor = {
	all: g.steps.script.hint.all,
	"chrome edge": g.steps.script.hint.tampermonkey,
	firefox: g.steps.script.hint.firefox,
	safari: g.steps.script.hint.safari,
	ios: g.steps.script.hint.ios,
};
const allRows = g.platforms.flatMap((p) => p.managers.map((m) => ({ platform: p.chip, ...m })));
const metadata = ["// ==UserScript==", "// @name Photos Swipe", "// @author sidlakkoju", "// @match https://photos.google.com/*", "// @grant GM.getValue"];
---

<dialog class="im" data-install-modal aria-labelledby="im-title" aria-describedby="im-sub">
	<div class="im-sheet lg-glass-thick" data-platform="all">
		<header class="im-head">
			<div class="im-heading">
				<h2 id="im-title" class="im-title">{g.title}</h2>
				<p id="im-sub" class="im-sub">{g.subtitle}</p>
			</div>
			<button type="button" class="im-close lg-icon-button" data-install-close aria-label="Close">
				<Icon name="close" size={18} />
			</button>
		</header>

		<div class="im-body">
			<ol class="im-steps" role="list">
				<!-- Step 1: userscript manager -->
				<li class="im-card">
					<div class="im-card-head">
						<span class="im-num" aria-hidden="true">1</span>
						<h3 class="im-card-title">{g.steps.manager}</h3>
					</div>

					<div class="im-picker" role="group" aria-label={g.pickerLabel}>
						{
							g.platforms.map((p) => (
								<button type="button" class="im-chip" data-pick={p.id} aria-pressed="false">
									{p.chip}
								</button>
							))
						}
					</div>

					<p class="im-ios-warn im-callout" data-ios-warn hidden>
						<Icon name="info" size={16} />
						<span>{g.iosNotSafari}</span>
					</p>

					{
						g.platforms.map((p) => (
							<div class="im-platform" data-show={p.id} hidden>
								<p class="im-blurb">
									<span class="im-detected" data-detected hidden>Detected · </span>
									{p.blurb}
								</p>
								<ul class="im-rows" role="list">
									{p.managers.map((m, i) => (
										<li class="im-row">
											<span class="im-row-text">
												<span class="im-row-name">
													{m.name}
													{i === 0 && p.managers.length > 1 && <span class="im-tag">Recommended</span>}
												</span>
												<span class="im-row-sub">{m.store}</span>
											</span>
											<a
												class:list={["im-pill", i === 0 ? "im-pill--primary" : "im-pill--glass"]}
												href={m.href}
												target="_blank"
												rel="noopener noreferrer"
												aria-label={`Get ${m.name} from the ${m.store.split(" · ")[0]}`}
											>
												Get
												<Icon name="external" size={14} />
											</a>
										</li>
									))}
								</ul>
								{p.note && (
									<p class="im-callout">
										<Icon name="info" size={16} />
										<span>{p.note}</span>
									</p>
								)}
							</div>
						))
					}

					<div class="im-platform" data-show="all">
						<p class="im-blurb">{g.allLabel} above for setup tips, or get a manager here.</p>
						<ul class="im-rows" role="list">
							{
								allRows.map((r) => (
									<li class="im-row">
										<span class="im-row-text">
											<span class="im-row-name">{r.platform}</span>
											<span class="im-row-sub">
												{r.name} · {r.store}
											</span>
										</span>
										<a
											class="im-pill im-pill--glass"
											href={r.href}
											target="_blank"
											rel="noopener noreferrer"
											aria-label={`Get ${r.name} for ${r.platform}`}
										>
											Get
											<Icon name="external" size={14} />
										</a>
									</li>
								))
							}
						</ul>
					</div>
				</li>

				<!-- Step 2: the script -->
				<li class="im-card">
					<div class="im-card-head">
						<span class="im-num" aria-hidden="true">2</span>
						<h3 class="im-card-title">{g.steps.script.title}</h3>
					</div>
					{
						Object.entries(hintFor).map(([show, text]) => (
							<p class="im-text" data-show={show} hidden={show !== "all"}>
								{text}
							</p>
						))
					}

					<!-- Desktop managers: Tampermonkey's install page -->
					<div
						class="im-vis im-vis--window"
						data-show="all chrome edge firefox"
						role="img"
						aria-label="Illustration: a browser tab showing Tampermonkey's install page for Photos Swipe, with the Install button highlighted."
					>
						<div class="vw-bar" aria-hidden="true">
							<span class="vw-dots"><i></i><i></i><i></i></span>
							<span class="vw-url">Tampermonkey · Userscript installation</span>
						</div>
						<div class="vw-page tm" aria-hidden="true">
							<div class="tm-head">
								<span class="tm-icon"><Icon name="braces" size={16} /></span>
								<span class="tm-name">
									<b>Photos Swipe</b>
									<span>by sidlakkoju · photos.google.com</span>
								</span>
							</div>
							<div class="tm-actions">
								<span class="vis-btn vis-btn--primary vis-target">
									Install
									<svg class="vis-cursor" viewBox="0 0 16 22" width="16" height="22">
										<path d="M1 1v16.5l4.2-4 2.9 6.9 2.9-1.2-2.9-6.8h5.8Z" fill="#fff" stroke="#000" stroke-width="1.2" stroke-linejoin="round" />
									</svg>
								</span>
								<span class="vis-btn">Cancel</span>
							</div>
							<code class="vis-code">{metadata.map((l) => <span>{l}</span>)}</code>
						</div>
					</div>

					<!-- Safari on Mac: the Userscripts toolbar popup -->
					<div
						class="im-vis im-vis--window"
						data-show="safari"
						hidden
						role="img"
						aria-label="Illustration: Safari showing the script, with the Userscripts toolbar popup open and its Install button highlighted."
					>
						<div class="vw-bar" aria-hidden="true">
							<span class="vw-dots"><i></i><i></i><i></i></span>
							<span class="vw-url">photoswiper.user.js</span>
							<span class="vw-ext">&lt;/&gt;</span>
						</div>
						<div class="vw-page" aria-hidden="true">
							<code class="vis-code">{metadata.map((l) => <span>{l}</span>)}</code>
							<div class="us-pop us-pop--mac">
								<span class="us-banner">Userscript Detected: <b>Click to install</b></span>
								<b class="us-name">Photos Swipe</b>
								<span class="us-meta">@match https://photos.google.com/*</span>
								<span class="us-buttons">
									<span class="vis-btn">Cancel</span>
									<span class="vis-btn vis-btn--primary vis-target">
										Install
										<svg class="vis-cursor" viewBox="0 0 16 22" width="16" height="22">
											<path d="M1 1v16.5l4.2-4 2.9 6.9 2.9-1.2-2.9-6.8h5.8Z" fill="#fff" stroke="#000" stroke-width="1.2" stroke-linejoin="round" />
										</svg>
									</span>
								</span>
							</div>
						</div>
					</div>

					<!-- iPhone and iPad: the Userscripts popup in Safari -->
					<div
						class="im-vis im-vis--phone"
						data-show="ios"
						hidden
						role="img"
						aria-label="Illustration: Safari on iPhone with the Userscripts popup open, showing Userscript Detected: Tap to install, and its Install button highlighted."
					>
						<div class="ph" aria-hidden="true">
							<div class="ph-screen">
								<code class="vis-code">{metadata.slice(0, 4).map((l) => <span>{l}</span>)}</code>
								<div class="us-pop us-pop--ios">
									<span class="us-title">Userscripts</span>
									<span class="us-banner">Userscript Detected: <b>Tap to install</b></span>
									<b class="us-name">Photos Swipe</b>
									<span class="us-meta">@match https://photos.google.com/*</span>
									<span class="us-buttons">
										<span class="vis-btn">Cancel</span>
										<span class="vis-btn vis-btn--primary vis-target">
											Install
											<span class="vis-tap"></span>
										</span>
									</span>
								</div>
								<div class="ph-bar">
									<span class="ph-ext">
										<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<path d="M19.4 13a2.5 2.5 0 0 0 0-2H18V7a1 1 0 0 0-1-1h-4V4.6a2.5 2.5 0 0 0-2 0V6H7a1 1 0 0 0-1 1v3.5h1.5a2.5 2.5 0 0 1 0 5H6V17a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-4Z" />
										</svg>
									</span>
									<span class="ph-url">photoswiper.user.js</span>
								</div>
							</div>
						</div>
					</div>

					<a class="im-cta" href={links.install} data-install-script>
						<Icon name="download" size={18} />
						{g.steps.script.button}
					</a>
				</li>

				<!-- Step 3: open Google Photos -->
				<li class="im-card im-card--row">
					<span class="im-num" aria-hidden="true">3</span>
					<p class="im-open-text">
						<span class="lg-visually-hidden">Step 3: </span>{g.steps.open.title}
						<span class="im-open-extra" data-show="ios" hidden>{g.steps.open.iosExtra}</span>
					</p>
					<a class="im-pill im-pill--glass" href={g.steps.open.href} target="_blank" rel="noopener noreferrer" aria-label="Open Google Photos">
						{g.steps.open.button}
						<Icon name="external" size={14} />
					</a>
				</li>
			</ol>

			<p class="im-safety">
				<Icon name="shield" size={15} />
				<span>
					{g.safety.text} · <a href={g.safety.href} target="_blank" rel="noopener noreferrer">{g.safety.link}</a>
				</span>
			</p>
		</div>
	</div>
</dialog>

<script>
	type Platform = "chrome" | "edge" | "firefox" | "safari" | "ios" | "all";

	// Best-effort detection. Anything unrecognized (Android, unusual
	// browsers) falls back to "all", which lists every option.
	function detect(): { platform: Platform; iosNotSafari: boolean } {
		const ua = navigator.userAgent;
		const iOS = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
		if (iOS) return { platform: "ios", iosNotSafari: /CriOS|FxiOS|EdgiOS|OPiOS|GSA\//.test(ua) };
		if (/Android/i.test(ua)) return { platform: "all", iosNotSafari: false };
		if (/Edg\//.test(ua)) return { platform: "edge", iosNotSafari: false };
		if (/Firefox\//.test(ua)) return { platform: "firefox", iosNotSafari: false };
		if (/Chrome\/|Chromium\//.test(ua)) return { platform: "chrome", iosNotSafari: false };
		if (/Macintosh/.test(ua) && /Version\/[\d.]+.*Safari\//.test(ua)) return { platform: "safari", iosNotSafari: false };
		return { platform: "all", iosNotSafari: false };
	}

	const dialog = document.querySelector<HTMLDialogElement>("[data-install-modal]");
	if (dialog && typeof dialog.showModal === "function") {
		const sheet = dialog.querySelector<HTMLElement>(".im-sheet")!;
		const detected = detect();
		let returnFocus: HTMLElement | null = null;

		function setPlatform(platform: Platform) {
			sheet.dataset.platform = platform;
			for (const el of dialog!.querySelectorAll<HTMLElement>("[data-show]")) {
				el.hidden = !el.dataset.show!.split(" ").includes(platform);
			}
			for (const chip of dialog!.querySelectorAll<HTMLElement>("[data-pick]")) {
				chip.setAttribute("aria-pressed", String(chip.dataset.pick === platform));
			}
			for (const el of dialog!.querySelectorAll<HTMLElement>("[data-detected]")) {
				el.hidden = platform !== detected.platform;
			}
			dialog!.querySelector<HTMLElement>("[data-ios-warn]")!.hidden = !(platform === "ios" && detected.iosNotSafari);
		}

		dialog.querySelector(".im-picker")!.addEventListener("click", (e) => {
			const chip = (e.target as HTMLElement).closest<HTMLElement>("[data-pick]");
			if (chip) setPlatform(chip.dataset.pick as Platform);
		});

		function open(opener: HTMLElement | null) {
			returnFocus = opener;
			setPlatform(detected.platform);
			dialog!.showModal();
			document.documentElement.classList.add("install-open");
			dialog!.querySelector<HTMLElement>(".im-body")!.scrollTop = 0;
		}

		for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-install-open]")) {
			link.setAttribute("aria-haspopup", "dialog");
			link.addEventListener("click", (e) => {
				// Let modified clicks (new tab, download) go straight to the script.
				if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
				e.preventDefault();
				open(link);
			});
		}

		dialog.querySelector("[data-install-close]")!.addEventListener("click", () => dialog.close());

		// Backdrop: a press that starts and ends outside the sheet.
		let downOutside = false;
		const outside = (e: MouseEvent) => {
			const r = sheet.getBoundingClientRect();
			return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
		};
		dialog.addEventListener("pointerdown", (e) => (downOutside = outside(e)));
		dialog.addEventListener("click", (e) => {
			if (downOutside && outside(e)) dialog.close();
			downOutside = false;
		});

		// Keep Tab and Shift+Tab inside the dialog.
		dialog.addEventListener("keydown", (e) => {
			if (e.key !== "Tab") return;
			const items = [...dialog.querySelectorAll<HTMLElement>("a[href], button:not([disabled])")].filter(
				(el) => el.offsetParent !== null || el.getClientRects().length > 0,
			);
			if (!items.length) return;
			const first = items[0];
			const last = items[items.length - 1];
			const active = document.activeElement;
			if (e.shiftKey && (active === first || !dialog.contains(active))) {
				e.preventDefault();
				last.focus();
			} else if (!e.shiftKey && (active === last || !dialog.contains(active))) {
				e.preventDefault();
				first.focus();
			}
		});

		dialog.addEventListener("close", () => {
			document.documentElement.classList.remove("install-open");
			returnFocus?.focus();
			returnFocus = null;
		});
	}
</script>

<style>
	/* ---- Dialog shell ---- */
	.im {
		--sheet-r: var(--lg-radius-xl); /* 40 */
		--sheet-pad: 20px;
		--card-r: 32px;
		--card-pad: 16px;
		--inner-r: calc(var(--card-r) - var(--card-pad)); /* 16 */
		box-sizing: border-box;
		width: min(600px, 100% - 48px);
		max-width: none;
		max-height: calc(100dvh - 48px);
		margin: auto;
		padding: 0;
		border: 0;
		overflow: visible;
		background: transparent;
		color: var(--lg-label);
		font-family: var(--lg-font-text);
	}
	.im::backdrop {
		background: rgba(0, 0, 0, 0.55);
	}
	.im[open] {
		display: flex;
	}
	.im-sheet {
		display: flex;
		flex-direction: column;
		box-sizing: border-box;
		width: 100%;
		max-height: inherit;
		border-radius: var(--sheet-r);
		overflow: hidden;
		/* Deeper than the shared Thick fill so text stays legible over the page. */
		background-color: rgba(40, 40, 46, 0.72);
	}
	@media (prefers-reduced-motion: no-preference) {
		.im[open] .im-sheet {
			animation: im-in 0.42s var(--lg-ease-spring);
		}
		.im[open]::backdrop {
			animation: im-fade 0.3s ease;
		}
	}
	@keyframes im-in {
		from {
			opacity: 0;
			transform: translateY(16px) scale(0.97);
		}
	}
	@keyframes im-fade {
		from {
			opacity: 0;
		}
	}
	:global(html.install-open) {
		overflow: hidden;
	}

	/* ---- Header: close button concentric with the sheet's corner ---- */
	.im-head {
		display: flex;
		align-items: flex-start;
		gap: 12px;
		flex: none;
		padding: var(--sheet-pad) var(--sheet-pad) 0;
	}
	.im-heading {
		flex: 1;
		min-width: 0;
		padding: 0 0 0 4px;
	}
	.im-title {
		margin: 0;
		font-family: var(--lg-font-display);
		font-size: 24px;
		line-height: 40px; /* centers on the 40px close button */
		font-weight: 700;
		letter-spacing: -0.4px;
	}
	.im-sub {
		margin: 0;
		font-size: 15px;
		line-height: 20px;
		letter-spacing: -0.2px;
		color: var(--lg-label-secondary);
	}
	.im-close {
		flex: none;
		width: calc(2 * (var(--sheet-r) - var(--sheet-pad))); /* 40 */
		height: calc(2 * (var(--sheet-r) - var(--sheet-pad)));
		padding: 0;
		border: 0;
		background: var(--lg-glass-fill-strong);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
		cursor: pointer;
	}
	.im-close:hover {
		background: rgba(255, 255, 255, 0.22);
	}

	/* ---- Body ---- */
	.im-body {
		flex: 1 1 auto;
		min-height: 0;
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 16px var(--sheet-pad) var(--sheet-pad);
		scrollbar-width: thin;
		scrollbar-color: rgba(255, 255, 255, 0.22) transparent;
		/* Content scrolling past the header or the sheet's bottom edge fades
		   out instead of being cut (both fades sit inside the body padding). */
		-webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 14px, #000 calc(100% - 14px), transparent);
		mask-image: linear-gradient(to bottom, transparent 0, #000 14px, #000 calc(100% - 14px), transparent);
	}
	.im-steps {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 12px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	/* Wide screens: steps 1 and 2 side by side, step 3 across. */
	@media (min-width: 960px) {
		.im {
			width: min(880px, 100% - 48px);
		}
		.im-steps {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.im-steps > :last-child {
			grid-column: 1 / -1;
		}
	}
	.im-card {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: var(--card-pad);
		border-radius: var(--card-r);
		background: rgba(255, 255, 255, 0.06);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
	}
	.im-card-head {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.im-num {
		flex: none;
		display: grid;
		place-items: center;
		width: calc(2 * var(--inner-r)); /* 32 */
		height: calc(2 * var(--inner-r));
		border-radius: 50%;
		background: var(--lg-tint-blue);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22);
		font-size: 15px;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}
	.im-card-title {
		margin: 0;
		font-size: 17px;
		line-height: 22px;
		font-weight: 600;
		letter-spacing: -0.4px;
	}
	.im-text,
	.im-blurb {
		margin: 0;
		font-size: 15px;
		line-height: 20px;
		letter-spacing: -0.2px;
		color: var(--lg-label-secondary);
		text-wrap: pretty;
	}
	.im-detected {
		color: var(--lg-label);
		font-weight: 600;
	}
	[hidden] {
		display: none !important;
	}

	/* ---- Platform picker ---- */
	.im-picker {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.im-chip,
	.im-pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 4px;
		box-sizing: border-box;
		height: calc(2 * var(--inner-r)); /* 32 */
		padding: 0 12px;
		border: 0;
		border-radius: var(--inner-r);
		color: var(--lg-label);
		font: 500 14px/18px var(--lg-font-text);
		letter-spacing: -0.15px;
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
		transition: transform 0.35s var(--lg-ease-spring), background-color 0.2s ease;
	}
	.im-chip {
		background: rgba(255, 255, 255, 0.08);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
	}
	.im-chip:hover {
		background: rgba(255, 255, 255, 0.16);
	}
	.im-chip[aria-pressed="true"] {
		background: var(--lg-tint-blue);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.28);
	}
	.im-chip:active,
	.im-pill:active,
	.im-cta:active {
		transform: scale(0.96);
	}

	/* ---- Manager rows ---- */
	.im-platform {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.im-rows {
		display: flex;
		flex-direction: column;
		gap: 8px;
