---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import LiveDemo from "../components/LiveDemo.astro";
import HowItWorks from "../components/HowItWorks.astro";
import { name, siteUrl, socialIcons } from "../data/site";
import { intro, links, features, installSteps } from "../data/photos-swipe";

const url = new URL("/photos-swipe/", siteUrl).href;
const title = "Photos Swipe: swipe to clean up Google Photos";
const description =
	"Photos Swipe is a free userscript for Google Photos. Swipe through your library and free up storage: left to trash, right to keep. Try the live demo.";
const github = socialIcons.find((s) => s.key === "github")!;

const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "SoftwareApplication",
			"@id": `${url}#app`,
			name: intro.title,
			description,
			url,
			image: new URL("/photos-swipe/icon.png", siteUrl).href,
			applicationCategory: "UtilitiesApplication",
			operatingSystem: "Web browser (userscript)",
			offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
			author: { "@id": `${siteUrl}#person` },
			sameAs: links.github,
		},
		{
			"@type": "WebPage",
			"@id": `${url}#webpage`,
			url,
			name: title,
			description,
			inLanguage: "en",
			isPartOf: { "@id": `${siteUrl}#website` },
			about: { "@id": `${url}#app` },
			primaryImageOfPage: { "@type": "ImageObject", url: new URL("/photos-swipe/og.png", siteUrl).href, width: 1200, height: 630 },
		},
		{ "@type": "Person", "@id": `${siteUrl}#person`, name, url: siteUrl },
	],
};
---

<BaseLayout
	title={title}
	description={description}
	url={url}
	ogImage="/photos-swipe/og.png"
	ogImageAlt="Photos Swipe app icon and title"
	structuredData={structuredData}
	icons={[
		{ rel: "icon", href: "/photos-swipe/favicon-64.png", type: "image/png", sizes: "64x64" },
		{ rel: "icon", href: "/photos-swipe/icon.svg", type: "image/svg+xml" },
		{ rel: "apple-touch-icon", href: "/photos-swipe/apple-touch-icon.png" },
	]}
	bodyClass="ps"
>
	<div class="ps-page">
		<div class="ps-bg" aria-hidden="true">
			<span class="wash wash--blue"></span>
			<span class="wash wash--cyan"></span>
			<span class="orb orb--silver"></span>
			<span class="orb orb--blue"></span>
			<span class="orb orb--cyan"></span>
		</div>

		<header class="ps-nav">
			<a class="lg-chip lg-glass-clear" href="/">
				<Icon name="arrow-left" size={16} />
				{name}
			</a>
			<a class="lg-icon-button lg-glass-clear" href={links.github} target="_blank" rel="noopener noreferrer" aria-label="Photos Swipe on GitHub">
				<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={github.path} /></svg>
			</a>
		</header>

		<main class="ps-main">
			<section class="ps-hero" aria-labelledby="ps-title">
				<div class="ps-intro">
					<img class="ps-icon" src="/photos-swipe/icon.png" alt="" width="96" height="96" />
					<h1 id="ps-title" class="ps-title">{intro.title}</h1>
					<p class="ps-lede">{intro.lede}</p>
					<div class="ps-ctas">
						<a class="lg-button lg-button--primary" href={links.install}>
							<Icon name="download" />
							Install
						</a>
						<a class="lg-button lg-button--secondary lg-glass-clear" href={links.github} target="_blank" rel="noopener noreferrer">
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={github.path} /></svg>
							GitHub
						</a>
					</div>
					<p class="ps-cta-caption">{intro.caption}</p>
				</div>

				<div class="ps-demo">
					<LiveDemo />
				</div>
			</section>

			<section class="ps-features" aria-label="Features">
				<ul role="list">
					{
						features.map((f) => (
							<li class="ps-feature lg-glass-regular">
								<span class="ps-bubble">
									<Icon name={f.icon} size={20} />
								</span>
								<span class="ps-feature-text">
									<span class="lg-headline">{f.title}</span>
									<span class="ps-feature-desc">{f.text}</span>
								</span>
							</li>
						))
					}
				</ul>
			</section>

			<HowItWorks />

			<section class="ps-install" id="install" aria-labelledby="install-title">
				<div class="ps-install-card lg-glass-regular">
					<div class="ps-install-head">
						<h2 id="install-title">Install</h2>
						<a class="lg-button lg-button--primary lg-button--small ps-install-btn" href={links.install}>
							<Icon name="download" size={17} />
							Install
						</a>
					</div>
					<ol class="ps-steps" role="list">
						{
							installSteps.map((s, i) => (
								<li>
									<span class="ps-step-num" aria-hidden="true">{i + 1}</span>
									<span class="ps-step-text">
										<span class="lg-headline">{s.title}</span>
										<span class="ps-step-desc">{s.text}</span>
									</span>
								</li>
							))
						}
					</ol>
					<a class="lg-button lg-button--primary ps-install-btn--wide" href={links.install}>
						<Icon name="download" />
						Install
					</a>
				</div>
			</section>
		</main>

		<footer class="ps-footer">
			<nav class="ps-socials" aria-label="Sid Lakkoju elsewhere">
				{
					socialIcons.map((s) => (
						<a href={s.href} target="_blank" rel="me noopener noreferrer" aria-label={`${name} on ${s.label}`}>
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d={s.path} />
							</svg>
						</a>
					))
				}
			</nav>
			<p>{name} · <a href="/">sidlakkoju.github.io</a></p>
		</footer>
	</div>
</BaseLayout>

<style is:global>
	html {
		background: var(--lg-bg);
		scrollbar-color: rgba(255, 255, 255, 0.22) transparent;
	}
	body.ps {
		margin: 0;
		background: var(--lg-bg);
		color: var(--lg-label);
		font-family: var(--lg-font-text);
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		-webkit-tap-highlight-color: transparent;
		text-rendering: optimizeLegibility;
	}
</style>

<style>
	.ps-page {
		position: relative;
		overflow-x: clip;
		min-height: 100vh;
	}

	/* ---- Background: color washes and a few static glossy orbs ---- */
	.ps-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
	}
	.wash {
		position: absolute;
		border-radius: 50%;
		filter: blur(60px);
	}
	.wash--blue {
		left: calc(50% + 40px);
		top: -260px;
		width: 900px;
		height: 900px;
		background: radial-gradient(closest-side, rgba(31, 47, 209, 0.85), rgba(31, 47, 209, 0.35) 55%, rgba(31, 47, 209, 0));
	}
	.wash--cyan {
		left: calc(50% - 1040px);
		top: 1300px;
		width: 800px;
		height: 700px;
		background: radial-gradient(closest-side, rgba(40, 150, 170, 0.42), rgba(40, 150, 170, 0));
	}
	.orb {
		position: absolute;
		border-radius: 50%;
	}
	.orb--silver {
		left: calc(50% - 645px);
		top: 105px;
		width: 90px;
		height: 90px;
		background: radial-gradient(circle at 35% 30%, #fff 0, #e9edf4 22%, #a9b0bf 62%, #5d6371 100%);
		box-shadow: 0 0 36px rgba(220, 225, 234, 0.35);
	}
	.orb--blue {
		left: calc(50% + 570px);
		top: 960px;
		width: 100px;
		height: 100px;
		background: radial-gradient(circle at 35% 30%, #a9b8ff 0, #4a64ff 25%, #2f4bff 55%, #1626a8 100%);
		box-shadow: 0 0 44px rgba(47, 75, 255, 0.55);
	}
	.orb--cyan {
		left: calc(50% - 669px);
		top: 1461px;
		width: 77px;
		height: 77px;
		background: radial-gradient(circle at 35% 30%, #e6fbff 0, #8ce6f8 22%, #5bd6f2 52%, #1f8fb0 100%);
		box-shadow: 0 0 40px rgba(91, 214, 242, 0.5);
	}

	/* ---- Layout ---- */
	.ps-nav,
	.ps-main,
	.ps-footer {
		position: relative;
		z-index: 1;
		box-sizing: border-box;
		width: 100%;
		max-width: 1248px;
		margin: 0 auto;
		padding-left: max(24px, var(--lg-safe-left));
		padding-right: max(24px, var(--lg-safe-right));
	}
	.ps-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: max(28px, calc(var(--lg-safe-top) + 12px));
	}
	.ps-nav .lg-icon-button svg {
		width: 20px;
		height: 20px;
	}
	.ps-nav .lg-chip {
		padding: 0 16px 0 12px;
	}

	.ps-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 48px;
		min-height: 820px;
		padding-top: 24px;
	}
	.ps-intro {
		max-width: 640px;
	}
	.ps-icon {
		display: block;
		width: 96px;
		height: 96px;
		border-radius: 22px;
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
	}
	.ps-title {
		margin: 22px 0 0;
		font-family: var(--lg-font-display);
		font-size: clamp(48px, 7vw, 96px);
		line-height: 1.04;
		font-weight: 600;
		letter-spacing: -0.025em;
	}
	.ps-lede {
		margin: 22px 0 0;
		font-size: 17px;
		line-height: 26px;
		letter-spacing: -0.4px;
		color: var(--lg-label-secondary);
		text-wrap: pretty;
	}
	.ps-ctas {
		display: flex;
		gap: 12px;
		margin-top: 22px;
	}
	.ps-ctas .lg-button svg {
		width: 20px;
		height: 20px;
	}
	.ps-cta-caption {
		margin: 22px 0 0;
		font-size: 13px;
		line-height: 18px;
		color: var(--lg-label-tertiary);
	}
	.ps-demo {
		padding-top: 48px;
	}

	/* ---- Features ---- */
	.ps-features ul {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
		margin: 96px 0 0;
		padding: 0;
		list-style: none;
	}
	.ps-feature {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 23px;
		border-radius: var(--lg-radius-lg);
	}
	.ps-bubble {
		flex: none;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--lg-glass-fill-strong);
		box-shadow: inset 0 0 0 1px var(--lg-glass-stroke);
	}
	.ps-feature-text,
	.ps-step-text {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}
	.ps-feature-desc,
	.ps-step-desc {
		font-size: 15px;
		line-height: 20px;
		letter-spacing: -0.2px;
		color: var(--lg-label-secondary);
		text-wrap: pretty;
	}

	/* ---- How it works ---- */
	.ps-main :global(.hiw) {
		margin-top: 112px;
	}

	/* ---- Install ---- */
	.ps-install {
		margin-top: 112px;
	}
	.ps-install-card {
		display: flex;
		align-items: center;
		gap: 40px;
		padding: 33px 41px;
		border-radius: var(--lg-radius-xl);
	}
	.ps-install-head {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 14px;
		flex: none;
	}
	.ps-install-head h2 {
		margin: 0;
		font-family: var(--lg-font-display);
		font-size: 28px;
		line-height: 34px;
		font-weight: 700;
		letter-spacing: -0.5px;
	}
	.ps-steps {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 40px;
		flex: 1;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.ps-steps li {
		display: flex;
		align-items: flex-start;
		gap: 12px;
	}
	.ps-step-num {
		flex: none;
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: 50%;
		background: var(--lg-tint-blue);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22);
		font-size: 15px;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}
	.ps-install-btn--wide {
		display: none;
	}

	/* ---- Footer ---- */
	.ps-footer {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 14px;
		padding-top: 80px;
		padding-bottom: max(56px, calc(var(--lg-safe-bottom) + 24px));
	}
	.ps-socials {
		display: flex;
		gap: 24px;
	}
	.ps-socials a {
		display: flex;
		color: var(--lg-label);
		opacity: 0.8;
		border-radius: 6px;
		transition: opacity 0.2s ease, transform 0.45s var(--lg-ease-spring);
	}
	.ps-socials a:hover {
		opacity: 1;
		transform: scale(1.12);
	}
	.ps-socials svg {
		width: 22px;
		height: 22px;
	}
	.ps-footer p {
		margin: 0;
		font-size: 13px;
		line-height: 18px;
		color: var(--lg-label-tertiary);
	}
	.ps-footer p a {
		color: inherit;
		text-decoration: none;
	}
	.ps-footer p a:hover {
		color: var(--lg-label-secondary);
	}
	.ps-socials a:focus-visible,
	.ps-footer p a:focus-visible {
		outline: 2px solid var(--lg-label);
		outline-offset: 3px;
	}

	/* ---- Narrower desktops ---- */
	@media (max-width: 1100px) {
		.ps-install-card {
			flex-direction: column;
			align-items: stretch;
		}
		.ps-install-head {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
		}
		.ps-steps {
			gap: 24px;
		}
	}
	@media (max-width: 959px) {
		.ps-hero {
			grid-template-columns: minmax(0, 1fr);
			min-height: 0;
			padding-top: 56px;
		}
		.ps-demo {
			padding-top: 8px;
		}
		.ps-features ul {
			grid-template-columns: minmax(0, 1fr);
			gap: 12px;
		}
	}

	/* ---- Phones ---- */
	@media (max-width: 699px) {
		.ps-nav,
		.ps-main,
		.ps-footer {
			padding-left: max(20px, var(--lg-safe-left));
			padding-right: max(20px, var(--lg-safe-right));
		}
		.ps-nav {
			padding-top: max(16px, calc(var(--lg-safe-top) + 10px));
		}
		.ps-hero {
			gap: 28px;
			padding-top: 32px;
		}
		.ps-icon {
			width: 80px;
			height: 80px;
			border-radius: 18px;
		}
		.ps-title {
			margin-top: 16px;
			font-size: 48px;
			line-height: 54px;
			font-weight: 700;
			letter-spacing: -1px;
		}
		.ps-lede {
			margin-top: 16px;
		}
		.ps-ctas {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 10px;
			margin-top: 16px;
		}
		.ps-ctas .lg-button {
			padding: 0 12px;
		}
		.ps-cta-caption {
			display: none;
		}
		.ps-demo {
			padding: 25px 20px 26px;
			border-radius: var(--lg-radius-xl);
			background: var(--lg-glass-fill);
			box-shadow: var(--lg-hairline), var(--lg-shadow-regular);
		}
		.ps-demo :global(.phone) {
			--phone-scale: 0.513;
			--bezel: 6px;
		}
		.ps-features ul {
			margin-top: 28px;
			gap: 10px;
		}
		.ps-feature {
			padding: 17px;
			gap: 14px;
		}
		.ps-bubble {
			width: 40px;
			height: 40px;
		}
		.ps-main :global(.hiw) {
			margin-top: 48px;
		}
		.ps-install {
			margin-top: 48px;
		}
		.ps-install-card {
			padding: 23px 21px 23px;
			gap: 16px;
		}
		.ps-install-head .ps-install-btn {
			display: none;
		}
		.ps-steps {
			grid-template-columns: minmax(0, 1fr);
			gap: 16px;
		}
		.ps-install-btn--wide {
			display: flex;
			margin-top: 0;
		}
		.ps-footer {
			padding-top: 40px;
		}
		.wash--blue {
			left: 60px;
			top: -200px;
			width: 520px;
			height: 520px;
		}
		.wash--cyan {
			left: -220px;
			top: 1700px;
			width: 500px;
			height: 500px;
		}
		.orb--silver {
			left: calc(100% - 60px);
			top: 730px;
			width: 60px;
			height: 60px;
		}
		.orb--blue {
			display: none;
		}
		.orb--cyan {
			left: -22px;
			top: 1290px;
			width: 60px;
			height: 60px;
		}
	}
	@media (max-width: 380px) {
		.ps-ctas .lg-button {
			font-size: 16px;
			gap: 6px;
		}
	}
</style>
