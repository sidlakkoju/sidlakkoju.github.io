---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import LiveDemo from "../components/LiveDemo.astro";
import HowItWorks from "../components/HowItWorks.astro";
import InstallModal from "../components/InstallModal.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { name, siteUrl, socialIcons } from "../data/site";
import { intro, links } from "../data/photos-swipe";

const url = new URL("/photos-swipe/", siteUrl).href;
const title = "Photos Swipe: swipe to clean up Google Photos";
const description =
	"Photos Swipe is a free userscript for Google Photos. Swipe through your library and free up storage: left to trash, right to keep. Try the live demo.";
const github = socialIcons.find((s) => s.key === "github")!;

const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "SoftwareApplication",
			"@id": `${url}#app`,
			name: intro.title,
			description,
			url,
			image: new URL("/photos-swipe/icon.png", siteUrl).href,
			applicationCategory: "UtilitiesApplication",
			operatingSystem: "Web browser (userscript)",
			offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
			author: { "@id": `${siteUrl}#person` },
			sameAs: links.github,
		},
		{
			"@type": "WebPage",
			"@id": `${url}#webpage`,
			url,
			name: title,
			description,
			inLanguage: "en",
			isPartOf: { "@id": `${siteUrl}#website` },
			about: { "@id": `${url}#app` },
			primaryImageOfPage: { "@type": "ImageObject", url: new URL("/photos-swipe/og.png", siteUrl).href, width: 1200, height: 630 },
		},
		{ "@type": "Person", "@id": `${siteUrl}#person`, name, url: siteUrl },
	],
};
---

<BaseLayout
	title={title}
	description={description}
	url={url}
	ogImage="/photos-swipe/og.png"
	ogImageAlt="Photos Swipe app icon and title"
	structuredData={structuredData}
	icons={[
		{ rel: "icon", href: "/photos-swipe/favicon-64.png", type: "image/png", sizes: "64x64" },
		{ rel: "icon", href: "/photos-swipe/icon.svg", type: "image/svg+xml" },
		{ rel: "apple-touch-icon", href: "/photos-swipe/apple-touch-icon.png" },
	]}
	bodyClass="ps"
>
	<div class="ps-page">
		<div class="ps-bg" aria-hidden="true">
			<span class="wash wash--blue"></span>
			<span class="wash wash--cyan"></span>
			<span class="orb orb--silver"></span>
			<span class="orb orb--blue"></span>
			<span class="orb orb--cyan"></span>
		</div>

		<header class="ps-nav">
			<a class="lg-chip" href="/" data-glass="clear" data-back>
				<Icon name="arrow-left" size={16} />
				{name}
			</a>
		</header>

		<main class="ps-main">
			<section class="ps-hero" aria-labelledby="ps-title">
				<div class="ps-intro">
					<ResponsiveImage
						class="ps-icon"
						base="/photos-swipe/icon"
						widths={[64, 128, 192, 288]}
						sizes="(max-width: 699px) 80px, 96px"
						fallback="png"
						alt=""
						width="96"
						height="96"
						decoding="async"
						data-morph
						style="view-transition-name: project-photos-swipe"
					/>
					<h1 id="ps-title" class="ps-title">{intro.title}</h1>
					<p class="ps-lede">{intro.lede}</p>
					<div class="ps-ctas">
						<a class="lg-button lg-button--primary" href={links.install} data-install-open>
							<Icon name="download" />
							Install
						</a>
						<a class="lg-button lg-button--secondary" href={links.github} target="_blank" rel="noopener noreferrer" data-glass="clear">
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={github.path} /></svg>
							GitHub
						</a>
					</div>
					<p class="ps-cta-caption">{intro.caption}</p>
				</div>

				<div class="ps-demo">
					<LiveDemo />
				</div>
			</section>

			<HowItWorks />

		</main>

		<footer class="ps-footer">
			<nav class="ps-socials" aria-label="Sid Lakkoju elsewhere">
				{
					socialIcons.map((s) => (
						<a class="lg-hit" href={s.href} target="_blank" rel="me noopener noreferrer" aria-label={`${name} on ${s.label}`}>
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d={s.path} />
							</svg>
						</a>
					))
				}
			</nav>
			<p>{name} · <a class="lg-hit" href="/" data-back>sidlakkoju.github.io</a></p>
		</footer>
	</div>

	<InstallModal />
</BaseLayout>

<script>
	import "../styles/liquid-refraction.css";
	import { initLiquidRefraction } from "../scripts/liquid-refraction";

	// Chromium gets the same refracting glass as the homepage's renderer;
	// Safari and Firefox keep the frosted fallback (no script work at all).
	initLiquidRefraction();

	// Arrived from the homepage: going "back" returns to it as the visitor
	// left it (scroll position, and the sim's state when the page was kept
	// in the back/forward cache) instead of loading a fresh copy at the top.
	const fromHome = (() => {
		try {
			const ref = new URL(document.referrer);
			return ref.origin === location.origin && ref.pathname === "/" && history.length > 1;
		} catch {
			return false;
		}
	})();
	for (const link of document.querySelectorAll<HTMLAnchorElement>("a[data-back]")) {
		link.addEventListener("click", (e) => {
			if (!fromHome || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
			e.preventDefault();
			history.back();
		});
	}

	// The icon morphs into the homepage's project card only when both ends
	// are on screen: leaving from further down the page, or for a fresh copy
	// of the homepage (scrolled to the top, card out of view), it just fades.
	const icon = document.querySelector<HTMLElement>("[data-morph]");
	window.addEventListener("pageswap", (e) => {
		if (!icon) return;
		const r = icon.getBoundingClientRect();
		const onScreen = r.bottom > 0 && r.top < window.innerHeight;
		const traverse = (e as Event & { activation?: { navigationType?: string } }).activation?.navigationType === "traverse";
		if (!onScreen || !traverse) icon.style.viewTransitionName = "none";
	});
	// Back from the cache: name it again for the next navigation.
	window.addEventListener("pageshow", () => icon?.style.setProperty("view-transition-name", "project-photos-swipe"));
</script>

<style is:global>
	html {
		background: var(--lg-bg);
		scrollbar-color: rgba(255, 255, 255, 0.22) transparent;
	}
	body.ps {
		margin: 0;
		background: var(--lg-bg);
		color: var(--lg-label);
		font-family: var(--lg-font-text);
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		-webkit-tap-highlight-color: transparent;
		text-rendering: optimizeLegibility;
	}
</style>

<style>
	.ps-page {
		position: relative;
		overflow-x: clip;
		min-height: 100vh;
	}

	/* ---- Background: color washes and a few static glossy orbs ---- */
	.ps-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
	}
	/* The washes used to be gradients under filter: blur(60px), which Safari
	   re-blurs whenever it repaints a tile (scrolling, every new tile). These
	   are the same washes with the blur baked in: the box grows by 3 sigma
	   (180px) per side and the stops sample the blurred profile. */
	.wash {
		position: absolute;
	}
	.wash--blue {
		left: calc(50% - 140px);
		top: -440px;
		width: 1260px;
		height: 1260px;
		background: radial-gradient(
			closest-side,
			rgba(31, 47, 209, 0.7) 0%,
			rgba(31, 47, 209, 0.67) 8%,
			rgba(31, 47, 209, 0.6) 17%,
			rgba(31, 47, 209, 0.51) 25%,
			rgba(31, 47, 209, 0.41) 33%,
			rgba(31, 47, 209, 0.316) 42%,
			rgba(31, 47, 209, 0.225) 50%,
			rgba(31, 47, 209, 0.14) 58%,
			rgba(31, 47, 209, 0.066) 67%,
			rgba(31, 47, 209, 0.022) 75%,
			rgba(31, 47, 209, 0.004) 83%,
			rgba(31, 47, 209, 0) 92%
		);
	}
	.wash--cyan {
		left: calc(50% - 1220px);
		top: 1120px;
		width: 1160px;
		height: 1060px;
		background: radial-gradient(
			closest-side,
			rgba(40, 150, 170, 0.336) 0%,
			rgba(40, 150, 170, 0.324) 8%,
			rgba(40, 150, 170, 0.292) 17%,
			rgba(40, 150, 170, 0.249) 25%,
			rgba(40, 150, 170, 0.201) 33%,
			rgba(40, 150, 170, 0.152) 42%,
			rgba(40, 150, 170, 0.103) 50%,
			rgba(40, 150, 170, 0.059) 58%,
			rgba(40, 150, 170, 0.027) 67%,
			rgba(40, 150, 170, 0.008) 75%,
			rgba(40, 150, 170, 0.002) 83%,
			rgba(40, 150, 170, 0) 92%
		);
	}
	.orb {
		position: absolute;
		border-radius: 50%;
	}
	.orb--silver {
		left: calc(50% - 645px);
		top: 105px;
		width: 90px;
		height: 90px;
		background: radial-gradient(circle at 35% 30%, #fff 0, #e9edf4 22%, #a9b0bf 62%, #5d6371 100%);
		box-shadow: 0 0 36px rgba(220, 225, 234, 0.35);
	}
	.orb--blue {
		left: calc(50% + 570px);
		top: 960px;
		width: 100px;
		height: 100px;
		background: radial-gradient(circle at 35% 30%, #a9b8ff 0, #4a64ff 25%, #2f4bff 55%, #1626a8 100%);
		box-shadow: 0 0 44px rgba(47, 75, 255, 0.55);
	}
	.orb--cyan {
		left: calc(50% - 669px);
		top: 1461px;
		width: 77px;
		height: 77px;
		background: radial-gradient(circle at 35% 30%, #e6fbff 0, #8ce6f8 22%, #5bd6f2 52%, #1f8fb0 100%);
		box-shadow: 0 0 40px rgba(91, 214, 242, 0.5);
	}

	/* ---- Layout ---- */
	.ps-nav,
	.ps-main,
	.ps-footer {
		position: relative;
		z-index: 1;
		box-sizing: border-box;
		width: 100%;
		max-width: 1248px;
		margin: 0 auto;
		padding-left: max(24px, var(--lg-safe-left));
		padding-right: max(24px, var(--lg-safe-right));
	}
	.ps-nav {
		display: flex;
		align-items: center;
		padding-top: max(28px, calc(var(--lg-safe-top) + 12px));
	}
	.ps-nav .lg-chip {
		padding: 0 16px 0 12px;
	}

	.ps-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 48px;
		min-height: 820px;
		padding-top: 24px;
	}
	.ps-intro {
		max-width: 640px;
	}
	.ps-icon {
		display: block;
		width: 96px;
		height: 96px;
		border-radius: 22px;
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
	}
	.ps-title {
		margin: 22px 0 0;
		font-family: var(--lg-font-display);
		font-size: clamp(48px, 7vw, 96px);
		line-height: 1.04;
		font-weight: 600;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}
	.ps-lede {
		margin: 22px 0 0;
		font-size: 17px;
		line-height: 26px;
		letter-spacing: -0.4px;
		color: var(--lg-label-secondary);
		text-wrap: pretty;
	}
	.ps-ctas {
		display: flex;
		gap: 12px;
		margin-top: 22px;
	}
	.ps-ctas .lg-button svg {
		width: 20px;
		height: 20px;
	}
	.ps-cta-caption {
		margin: 22px 0 0;
		font-size: 13px;
		line-height: 18px;
		color: var(--lg-label-tertiary);
	}
	.ps-demo {
		padding-top: 48px;
	}

	/* ---- How it works ---- */
	.ps-main :global(.hiw) {
		margin-top: 112px;
	}

	/* ---- Footer ---- */
	.ps-footer {
		display: flex;
		flex-direction: column;
		align-items: center;
		/* 24px keeps the icons' and the link's 44px touch areas apart. */
		gap: 24px;
		padding-top: 96px;
		padding-bottom: max(56px, calc(var(--lg-safe-bottom) + 24px));
	}
	.ps-socials {
		display: flex;
		gap: 24px;
	}
	.ps-socials a {
		display: flex;
		color: var(--lg-label);
		opacity: 0.8;
		border-radius: 6px;
		transition: opacity 0.2s ease, transform 0.45s var(--lg-ease-spring);
	}
	@media (hover: hover) {
		.ps-socials a:hover {
			opacity: 1;
			transform: scale(1.12);
		}
		.ps-footer p a:hover {
			color: var(--lg-label);
		}
	}
	.ps-socials a:active {
		opacity: 1;
		transform: scale(0.92);
		transition-duration: 0.15s;
	}
	.ps-footer p a:active {
		color: var(--lg-label);
	}
	.ps-socials svg {
		width: 22px;
		height: 22px;
	}
	.ps-footer p {
		margin: 0;
		font-size: 13px;
		line-height: 18px;
		color: var(--lg-label-tertiary);
	}
	.ps-footer p a {
		color: inherit;
		text-decoration: none;
	}
	.ps-socials a:focus-visible,
	.ps-footer p a:focus-visible {
		outline: 2px solid var(--lg-label);
		outline-offset: 3px;
	}

	/* ---- Narrower desktops ---- */
	@media (max-width: 959px) {
		.ps-hero {
			grid-template-columns: minmax(0, 1fr);
			min-height: 0;
			padding-top: 56px;
		}
		.ps-demo {
			padding-top: 8px;
		}
	}

	/* ---- Phones ---- */
	@media (max-width: 699px) {
		.ps-nav,
		.ps-main,
		.ps-footer {
			padding-left: max(20px, var(--lg-safe-left));
			padding-right: max(20px, var(--lg-safe-right));
		}
		.ps-nav {
			padding-top: max(16px, calc(var(--lg-safe-top) + 10px));
		}
		.ps-hero {
			gap: 28px;
			padding-top: 32px;
		}
		.ps-icon {
			width: 80px;
			height: 80px;
			border-radius: 18px;
		}
		.ps-title {
			margin-top: 16px;
			font-size: 48px;
			line-height: 54px;
			font-weight: 700;
			letter-spacing: -1px;
		}
		.ps-lede {
			margin-top: 16px;
		}
		.ps-ctas {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 10px;
			margin-top: 16px;
		}
		.ps-ctas .lg-button {
			padding: 0 12px;
		}
		.ps-cta-caption {
			display: none;
		}
		.ps-demo {
			padding: 25px 20px 26px;
			border-radius: var(--lg-radius-xl);
			background: var(--lg-glass-fill);
			box-shadow: var(--lg-hairline), var(--lg-shadow-regular);
		}
		.ps-demo :global(.phone) {
			--phone-scale: 0.513;
			--bezel: 6px;
		}
		.ps-main :global(.hiw) {
			margin-top: 48px;
		}
		.ps-footer {
			padding-top: 56px;
		}
		/* Backdrop blur over these smooth washes is invisible but costs a
		   live blur layer per control in iOS Safari; plain glass fill. (Where
		   SVG refraction runs, [data-glass-active] draws its own layer.) */
		.ps-page :global(.lg-glass-clear),
		.ps-page :global([data-glass]:not([data-glass-active])) {
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
		}
		.wash--blue {
			left: -120px;
			top: -380px;
			width: 880px;
			height: 880px;
			background: radial-gradient(
				closest-side,
				rgba(31, 47, 209, 0.59) 0%,
				rgba(31, 47, 209, 0.566) 8%,
				rgba(31, 47, 209, 0.503) 17%,
				rgba(31, 47, 209, 0.409) 25%,
				rgba(31, 47, 209, 0.311) 33%,
				rgba(31, 47, 209, 0.214) 42%,
				rgba(31, 47, 209, 0.126) 50%,
				rgba(31, 47, 209, 0.064) 58%,
				rgba(31, 47, 209, 0.027) 67%,
				rgba(31, 47, 209, 0.008) 75%,
				rgba(31, 47, 209, 0.002) 83%,
				rgba(31, 47, 209, 0) 92%
			);
		}
		.wash--cyan {
			left: -400px;
			top: 1520px;
			width: 860px;
			height: 860px;
			background: radial-gradient(
				closest-side,
				rgba(40, 150, 170, 0.295) 0%,
				rgba(40, 150, 170, 0.284) 8%,
				rgba(40, 150, 170, 0.254) 17%,
				rgba(40, 150, 170, 0.21) 25%,
				rgba(40, 150, 170, 0.16) 33%,
				rgba(40, 150, 170, 0.11) 42%,
				rgba(40, 150, 170, 0.065) 50%,
				rgba(40, 150, 170, 0.033) 58%,
				rgba(40, 150, 170, 0.013) 67%,
				rgba(40, 150, 170, 0.004) 75%,
				rgba(40, 150, 170, 0.001) 83%,
				rgba(40, 150, 170, 0) 92%
			);
		}
		/* Peeking in at the right edge beside the app icon, the one spot in
		   the hero with no content (it used to overlap the demo card). */
		.orb--silver {
			left: calc(100% - 40px);
			top: 108px;
			width: 60px;
			height: 60px;
		}
		.orb--blue {
			display: none;
		}
		/* Down by the footer, clear of the How it works diagram. */
		.orb--cyan {
			left: -22px;
			top: auto;
			bottom: 72px;
			width: 60px;
			height: 60px;
		}
	}
	@media (max-width: 380px) {
		.ps-ctas .lg-button {
			font-size: 16px;
			gap: 6px;
		}
	}
</style>
