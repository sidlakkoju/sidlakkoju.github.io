---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import "../styles/liquid-refraction.css";
import { name, siteUrl, profiles, projects } from "../data/site";

const title = name;
const description =
	"Sid Lakkoju is an engineer at SpaceX. Personal site with links to Sid's YouTube, GitHub, and LinkedIn, plus an interactive three-body gravity simulation.";
const ogImage = new URL("/og.png", siteUrl).href;

// One linked graph so search engines can tie the person, the site, and the
// profile page together (and to the sameAs profiles for the knowledge panel).
const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Person",
			"@id": `${siteUrl}#person`,
			name,
			givenName: "Sid",
			familyName: "Lakkoju",
			url: siteUrl,
			jobTitle: "Engineer",
			worksFor: {
				"@type": "Organization",
				name: "SpaceX",
				url: "https://www.spacex.com/",
				sameAs: "https://en.wikipedia.org/wiki/SpaceX",
			},
			sameAs: Object.values(profiles),
		},
		{
			"@type": "WebSite",
			"@id": `${siteUrl}#website`,
			url: siteUrl,
			name,
			inLanguage: "en",
			publisher: { "@id": `${siteUrl}#person` },
		},
		{
			"@type": "ProfilePage",
			"@id": `${siteUrl}#profilepage`,
			url: siteUrl,
			name: title,
			description,
			inLanguage: "en",
			isPartOf: { "@id": `${siteUrl}#website` },
			mainEntity: { "@id": `${siteUrl}#person` },
			primaryImageOfPage: { "@type": "ImageObject", url: ogImage, width: 1200, height: 630 },
		},
	],
};
---

<BaseLayout
	title={title}
	description={description}
	url={siteUrl}
	ogType="profile"
	ogImageAlt="Sid Lakkoju, with three orbiting planets"
	structuredData={structuredData}
	bodyClass="home"
>
	<Fragment slot="head">
		{Object.values(profiles).map((href) => <link rel="me" href={href} />)}
		<meta property="profile:first_name" content="Sid" />
		<meta property="profile:last_name" content="Lakkoju" />
		<!-- Start the wasm download from the head (not a rel=preload: Safari
		     doesn't hand a preloaded as=fetch response to fetch() and downloads
		     it twice). The bundle's load() picks this up. Skipped entirely under
		     reduced motion, where the sim never runs. -->
		<script is:inline>
			if (!matchMedia("(prefers-reduced-motion: reduce)").matches) window.mq_wasm_fetch = fetch("/sim/gravity_simulation.wasm");
		</script>
		<!-- Prefetch the project pages so opening one is instant: browsers with
		     speculation rules fetch on hover or press; the others get the page
		     script's fallback. -->
		<script is:inline type="speculationrules" set:html={JSON.stringify({ prefetch: [{ urls: projects.map((p) => p.href), eagerness: "moderate" }] })} />
		<!-- A project card's icon morphs into the project page's icon (and back)
		     only while it's on screen; otherwise the pages just crossfade. -->
		<script is:inline>
			(() => {
				const name = (e) => {
					if (!e.viewTransition) return;
					for (const el of document.querySelectorAll("[data-vt]")) {
						const r = el.getBoundingClientRect();
						el.style.viewTransitionName = r.bottom > 0 && r.top < innerHeight ? el.dataset.vt : "none";
					}
				};
				addEventListener("pagereveal", name);
				addEventListener("pageswap", name);
			})();
		</script>
	</Fragment>

		<canvas id="glcanvas" tabindex="0" aria-label="Interactive three-body gravity simulation"></canvas>

		<!-- Once the sim is running, the renderer draws this headline and the
		     icons itself (from pixels rasterized below) so the glass can refract
		     them. The HTML stays underneath as the accessible/indexable copy and
		     as the fallback when WebGL or motion is unavailable. -->
		<main>
			<h1>{name}</h1>
			<p>Nerd @SpaceX 🚀</p>

			<nav class="social-links" aria-label="Social links">
				<a href={profiles.youtube} target="_blank" rel="me noopener noreferrer" aria-label="Sid Lakkoju on YouTube">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
					</svg>
				</a>
				<a href={profiles.github} target="_blank" rel="me noopener noreferrer" aria-label="Sid Lakkoju on GitHub">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
					</svg>
				</a>
				<a href={profiles.linkedin} target="_blank" rel="me noopener noreferrer" aria-label="Sid Lakkoju on LinkedIn">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
					</svg>
				</a>
			</nav>
		</main>

		<a class="scroll-hint lg-glass-clear" href="#projects" aria-label="Scroll to projects" data-glass="clear">
			<span>Projects</span>
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
		</a>

		<!-- The sim stays fixed behind everything; only this content scrolls. -->
		<section id="projects" class="shelf" aria-labelledby="projects-title">
			<div class="shelf-content">
				<h2 id="projects-title" class="lg-eyebrow reveal" style="--i: 0">Projects</h2>
				<ul class="shelf-grid" role="list">
					{projects.map((p, i) => (
						<li class="reveal" style={`--i: ${i + 1}`}>
							<ProjectCard href={p.href} title={p.title} tagline={p.tagline} icon={p.icon} transitionName={`project-${p.slug}`} />
						</li>
					))}
					<!-- Keeps one project from looking lonely. Remove once there are two. -->
					<li class="reveal" style={`--i: ${projects.length + 1}`} aria-hidden="true">
						<div class="more-soon">More soon</div>
					</li>
				</ul>
			</div>
		</section>

		<!-- Glass UI. Elements marked .glass are drawn by the renderer as
		     refractive glass at their on-screen rect; the HTML only provides the
		     content, layout, and hit areas. -->
		<div class="sim-ui">
			<div class="sim-buttons">
				<button id="add-btn" class="glass glass-btn" aria-label="Add planet" tabindex="-1">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5.5v13M5.5 12h13" /></svg>
				</button>
				<button id="pause-btn" class="glass glass-btn" aria-label="Pause simulation" aria-pressed="false">
					<svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 7v10M15 7v10" /></svg>
					<svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path class="fill" d="M8.75 6.9v10.2a.9.9 0 0 0 1.38.76l8.03-5.1a.9.9 0 0 0 0-1.52l-8.03-5.1a.9.9 0 0 0-1.38.76Z" /></svg>
				</button>
			</div>

			<div id="body-controls"></div>

			<aside id="sim-info" class="glass glass-panel" aria-live="polite">
				<h2>The three-body problem</h2>
				<p>
					There's no general closed-form solution. Even tiny differences in starting
					conditions lead to wildly different orbits.
				</p>
				<a class="formula" href="https://en.wikipedia.org/wiki/Newton%27s_law_of_universal_gravitation" target="_blank" rel="noopener noreferrer">
					<span class="math" aria-label="F g equals G times m 1 m 2 over d squared">
						<span>F<sub>g</sub></span>
						<span class="op">=</span>
						<span>G</span>
						<span class="frac">
							<span>m<sub>1</sub>m<sub>2</sub></span>
							<span>d<sup>2</sup></span>
						</span>
					</span>
					<span class="formula-label">Newton's law of gravitation <span aria-hidden="true">↗</span></span>
				</a>
				<p>i think this is super cool - you should watch the netflix show.</p>
				<p class="hint">Drag a planet to move it. Drag its arrow to change its velocity.</p>
			</aside>
		</div>

		<!-- Sizes must match CTL_* in gravity_simulation/src/main.rs. -->
		<template id="body-ctl-template">
			<button class="remove" data-action="remove" aria-label="Remove planet" tabindex="-1">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 8l8 8M16 8l-8 8" /></svg>
			</button>
			<div class="stepper">
				<button data-action="lighter" aria-label="Decrease mass" tabindex="-1">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 12h11" /></svg>
				</button>
				<output aria-label="Mass"></output>
				<button data-action="heavier" aria-label="Increase mass" tabindex="-1">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 6.5v11M6.5 12h11" /></svg>
				</button>
			</div>
		</template>

		<script>
			import { animateFavicon } from "../favicon.js";
			animateFavicon();

			const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			const shelf = document.getElementById("projects")!;

			// The sim's renderer draws the shelf's glass once it runs (html.sim-glass).
			// Without it (reduced motion, no WebGL, wasm failed), the shelf gets the
			// SVG refraction fallback where supported, else the CSS frosted glass.
			// Loaded only then: the sim normally draws this glass itself.
			const glassFallback = () => {
				if (document.documentElement.classList.contains("sim-live")) return;
				import("../scripts/liquid-refraction").then((m) => m.initLiquidRefraction(document));
			};
			if (reduce) glassFallback();
			else setTimeout(glassFallback, 6000);

			// Without speculation rules (older Safari, Firefox), warm the HTTP cache with
			// a project page's HTML once its card is on screen (GitHub Pages
			// lets it be reused for 10 minutes).
			const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
			if (!HTMLScriptElement.supports?.("speculationrules") && !saveData && "IntersectionObserver" in window) {
				const warmed = new Set<string>();
				const io = new IntersectionObserver((entries) => {
					for (const e of entries) {
						if (!e.isIntersecting) continue;
						const href = (e.target as HTMLAnchorElement).href;
						io.unobserve(e.target);
						if (warmed.has(href)) continue;
						warmed.add(href);
						const go = () => fetch(href, { priority: "low" } as RequestInit).catch(() => {});
						if ("requestIdleCallback" in window) requestIdleCallback(go, { timeout: 2000 });
						else setTimeout(go, 300);
					}
				});
				for (const card of shelf.querySelectorAll(".project-card")) io.observe(card);
			}

			// The hint smooth-scrolls to the shelf (instantly under reduced motion).
			document.querySelector(".scroll-hint")!.addEventListener("click", (e) => {
				e.preventDefault();
				shelf.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "end" });
			});

			// Browsers without scroll-driven animations (Safari) reveal the shelf
			// with a staggered transition when it scrolls into view.
			if (!reduce && !CSS.supports("animation-timeline: view()") && "IntersectionObserver" in window) {
				shelf.classList.add("io-reveal");
				new IntersectionObserver(
					(entries, io) => {
						if (entries.some((e) => e.isIntersecting)) {
							shelf.classList.add("in-view");
							io.disconnect();
						}
					},
					{ rootMargin: "0px 0px -12% 0px" },
				).observe(shelf.querySelector(".shelf-grid")!);
			}
		</script>

		<!-- Deferred so it never holds up first paint; the page script below
		     runs once it has (DOMContentLoaded fires after deferred scripts). -->
		<script is:inline defer src="/sim/mq_js_bundle.js"></script>
		<script is:inline>
		// Wrapped in a function so these names can't collide with
		// mq_js_bundle.js's top-level globals (it already declares `canvas`).
		// A function, not a bare block: iOS 17 Safari mis-scopes async
		// function declarations inside blocks.
		addEventListener("DOMContentLoaded", () => {
			// macroquad's shim exposes `load(path)` once mq_js_bundle.js has run.
			// Honor prefers-reduced-motion by skipping the sim entirely.
			const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

			// Render resolution. A full-screen canvas at 3x is ~3.8M pixels a
			// frame for very little visible gain over 2x, so the backing store
			// is capped at MAX_SCALE device px per CSS px, and drops further
			// (SCALE_STEPS) while frames run over budget. miniquad and the input
			// mapping keep the startup scale (mq_dpi_scale); only the canvas
			// backing store (mq_render_scale) changes. See mq_js_bundle.js.
			const MAX_SCALE = 2;
			const SCALE_STEPS = [1, 0.875, 0.75, 0.625];
			const deviceScale = () => Math.min(window.devicePixelRatio || 1, MAX_SCALE);
			if (!reduce) {
				window.mq_dpi_scale = window.mq_render_scale = deviceScale();
				load("/sim/gravity_simulation.wasm");
			} else {
				document.getElementById("glcanvas").style.display = "none";
			}

			const root = document.documentElement;
			const canvas = document.getElementById("glcanvas");
			const main = document.querySelector("main");
			const heading = main.querySelector("h1");
			const tagline = main.querySelector("p");
			const nav = document.querySelector(".social-links");
			const iconLinks = [...nav.querySelectorAll("a")];
			const pauseBtn = document.getElementById("pause-btn");
			const addBtn = document.getElementById("add-btn");
			const infoCard = document.getElementById("sim-info");
			const bodyControls = document.getElementById("body-controls");
			const template = document.getElementById("body-ctl-template");
			const shelf = document.getElementById("projects");
			const shelfContent = shelf.querySelector(".shelf-content");
			const hint = document.querySelector(".scroll-hint");
			const revealEls = [...shelf.querySelectorAll(".reveal")];
			const cardEls = [...shelf.querySelectorAll(".project-card")];
			const massFormat = new Intl.NumberFormat("en-US");

			// Must match CTL_* in main.rs so the HTML lands on the drawn glass.
			const CTL_GAP = 14;
			const STEPPER_H = 32;

			// Performance model: nothing in the per-frame loop reads layout or
			// computed styles. Layout is measured once (and on resize), every
			// animation is a spring computed here, and the DOM and the renderer
			// are only written when a value actually changes. The page's frame
			// work runs in mq_before_frame, right before the sim draws, so what
			// it hands the renderer (scroll offsets, glass shapes) is drawn in
			// the same frame. When nothing would change on screen the sim frame
			// is skipped entirely (the canvas keeps its last image).

			let paused = false;
			let layout = null;
			let live = false; // page script drives the renderer
			let glassOn = false; // the renderer draws the shelf's glass

			// ---- Page scroll ----------------------------------------------------
			// The canvas is fixed; the page scrolls over it. While it does, the
			// headline the renderer draws fades and drifts up a bit faster than
			// the content (no drift or fade under reduced motion).
			//
			// Anything the canvas draws lags native scrolling by a frame or more
			// (iOS momentum scrolling especially), so while the page is
			// actively scrolling the HTML headline stands in for the canvas
			// copy, and hands back once scrolling settles. The shelf and the
			// scroll pill go the other way: they're fixed, and moved here in
			// the same frame as their glass (see applyShelf), so the glass
			// stays liquid while scrolling and their content stays on it, even
			// through a rubber-band bounce.
			let scrollY = window.scrollY;
			let viewportH = window.innerHeight;
			let lastScrollEvent = -Infinity;
			let scrolling = false;
			const SCROLL_SETTLE_MS = 180;
			// Touch devices scroll natively instead (see "Touch scrolling"
			// below): iOS Safari runs page animation at 60fps at most while it
			// scrolls at the display's 120Hz, so nothing that moves with the page
			// may be positioned from script there.
			const touchScroll = matchMedia("(pointer: coarse)").matches;
			const viewTimeline = CSS.supports("animation-timeline: view()");
			let touchActive = false;
			let nativeMode = false;
			const NATIVE_SETTLE_MS = 300;
			if (touchScroll) root.classList.add("touch-scroll");
			// No parallax drift on touch: it would have to be written every frame.
			const DRIFT = touchScroll ? 0 : 0.35; // extra upward drift per px scrolled
			const FADE_OVER = 0.5; // fully faded after half a screen
			const heroDrift = () => (reduce ? 0 : -DRIFT * scrollY);
			const heroFade = () => (reduce ? 1 : 1 - clamp01(scrollY / (viewportH * FADE_OVER)));
			// The info card belongs to the first screen; scrolling away hides it.
			const cardWanted = () => paused && scrollY < viewportH * 0.25;
			const hintWanted = () => scrollY <= 40 && !paused;
			const pool = []; // per-body controls; pool[i] belongs to body i

			// ---- Springs --------------------------------------------------------

			const spring = (x = 0) => ({ x, v: 0, to: x });
			const springs = {
				card: spring(),
				add: spring(),
				body: spring(),
				lift: spring(),
				pressPause: spring(),
				pressAdd: spring(),
				pressHint: spring(),
				hint: spring(hintWanted() ? 1 : 0),
				// Touch: how much of the shelf's glass the renderer draws (0
				// while the page scrolls natively and CSS glass stands in), and
				// the time-based reveal where scroll-driven animations are missing.
				glassMix: spring(1),
				shelfReveal: spring(0),
				icons: iconLinks.map(() => spring()),
				cardHover: cardEls.map(() => spring()),
				cardPress: cardEls.map(() => spring()),
			};
			const SPRINGS = Object.values(springs).flat();

			// Slightly underdamped (damping ratio ~0.85), ~0.4s settle: a soft
			// Apple-style spring with a hint of overshoot.
			function step(s, dt) {
				if (s.x === s.to && s.v === 0) return false;
				s.v += (260 * (s.to - s.x) - 27 * s.v) * dt;
				s.x += s.v * dt;
				if (Math.abs(s.to - s.x) < 5e-4 && Math.abs(s.v) < 5e-3) {
					s.x = s.to;
					s.v = 0;
				}
				return true;
			}
			const clamp01 = (x) => Math.min(1, Math.max(0, x));

			// Cached DOM writes: a style is only touched when its value changes.
			function setStyle(el, prop, value) {
				const cache = el._styles || (el._styles = {});
				if (cache[prop] === value) return;
				cache[prop] = value;
				if (prop.startsWith("--")) el.style.setProperty(prop, value);
				else el.style[prop] = value;
			}
			function setClass(name, on) {
				if (root.classList.contains(name) !== on) root.classList.toggle(name, on);
			}

			// ---- Layout ---------------------------------------------------------

			function rectOf(el) {
				const r = el.getBoundingClientRect();
				return { x: r.left, y: r.top, w: r.width, h: r.height };
			}

			// Measure everything at rest (transforms off) in one forced layout.
			function measure() {
				root.classList.add("measuring");
				// Content that scrolls with the page is kept in document
				// coordinates; the fixed controls stay in viewport ones.
				const sy = window.scrollY;
				const docRect = (el) => {
					const r = rectOf(el);
					r.y += sy;
					return r;
				};
				scrollY = sy;
				viewportH = window.innerHeight;
				layout = {
					canvasH: canvas.clientHeight,
					pause: rectOf(pauseBtn),
					add: rectOf(addBtn),
					card: rectOf(infoCard),
					cardRadius: parseFloat(getComputedStyle(infoCard).borderTopLeftRadius),
					heading: docRect(heading),
					tagline: docRect(tagline),
					nav: docRect(nav),
					icons: iconLinks.map((a) => docRect(a.querySelector("svg"))),
					// The shelf rises in (opacity + translate) as it scrolls into
					// view; the page drives that so the glass can follow it exactly.
					reveal: revealEls.map((el) => ({ el, i: parseFloat(el.style.getPropertyValue("--i")) || 0, ...docRect(el), p: -1 })),
					hint: docRect(hint),
					shelfY: docRect(shelfContent).y,
				};
				const shelfH = shelfContent.offsetHeight;
				layout.cards = cardEls.map((el) => ({
					...docRect(el),
					radius: parseFloat(getComputedStyle(el).borderTopLeftRadius),
					reveal: layout.reveal.find((r) => r.el.contains(el)),
				}));
				root.classList.remove("measuring");
				layout.maxScroll = Math.max(0, document.documentElement.scrollHeight - viewportH);
				setStyle(shelf, "--shelf-content-h", `${shelfH}px`);
				// While the card is up, lift the headline just enough to clear it,
				// but never under the top buttons.
				const needed = layout.card.y - 20 - (layout.nav.y - sy + layout.nav.h);
				layout.lift = Math.max(Math.min(0, needed), -(layout.heading.y - sy - 80));
				for (const el of [infoCard, main, hint, shelfContent, ...revealEls, ...cardEls]) el._styles = null;
				dirty = true;
			}

			// ---- Render resolution ----------------------------------------------

			let scaleLevel = 0;
			let appliedScale = 0;
			function applyScale() {
				const ex = window.wasm_exports;
				const s = Math.max(1, Math.round(deviceScale() * SCALE_STEPS[scaleLevel] * 8) / 8);
				if (s === appliedScale) return;
				appliedScale = s;
				window.mq_render_scale = s;
				// resize() is the bundle's: it sizes the backing store and tells the sim.
				resize(canvas, ex.resize);
				ex.set_render_scale?.(canvas.width / canvas.clientWidth);
				redraw(2);
			}

			// Frame budget: per window of 30 rendered frames, count the ones
			// that took over 1.5 refresh periods (and over 20ms: 60fps is fine
			// on a 120Hz display). Two bad windows in a row (a
			// quarter of frames late) drop a step; a run of clean windows raises
			// it again, but not soon after that step failed. Frames right after
			// a change (reallocating the canvas) don't count.
			// The refresh period estimate is the fastest recent window's
			// 10th-percentile interval (robust to the odd short catch-up frame),
			// drifting up 5% a window so one burst of fast frames can't pin it,
			// and never slower than 60Hz (a device that's slow from the first
			// frame would otherwise look normal).
			const budget = { frames: 0, intervals: new Float32Array(30), sorted: new Float32Array(30), period: Infinity, bad: 0, calm: 0, ignore: 10, failedAt: SCALE_STEPS.map(() => -Infinity) };
			function changeScale(level, now) {
				const b = budget;
				if (level > scaleLevel) b.failedAt[scaleLevel] = now;
				scaleLevel = level;
				b.bad = b.calm = 0;
				b.ignore = 10;
				b.frames = 0;
				applyScale();
			}
			function checkBudget(now, interval) {
				const b = budget;
				if (interval <= 0 || interval > 250) return;
				if (b.ignore > 0) {
					b.ignore--;
					return;
				}
				b.intervals[b.frames++] = interval;
				if (b.frames < 30) return;
				b.frames = 0;
				b.sorted.set(b.intervals);
				b.sorted.sort();
				b.period = Math.max(6.5, Math.min(b.period * 1.05, b.sorted[3], 1000 / 60));
				const late = Math.max(b.period * 1.5, 20);
				let slow = 0;
				for (const x of b.intervals) if (x > late) slow++;
				if (slow >= 8) {
					b.calm = 0;
					if (++b.bad >= 2 && scaleLevel < SCALE_STEPS.length - 1) changeScale(scaleLevel + 1, now);
				} else {
					b.bad = 0;
					if (slow <= 1 && ++b.calm >= 8 && scaleLevel > 0 && now - b.failedAt[scaleLevel - 1] > 20000) changeScale(scaleLevel - 1, now);
					else if (slow > 1) b.calm = 0;
				}
			}

			// ---- Pixel upload into the renderer -------------------------------

			function upload(ex, slot, ctx, x, y, w, h) {
				const { width, height } = ctx.canvas;
				const pixels = ctx.getImageData(0, 0, width, height).data;
				const ptr = ex.ui_alloc(pixels.length);
				// Read the buffer after ui_alloc: allocating may grow wasm memory.
				new Uint8Array(wasm_memory.buffer, ptr, pixels.length).set(pixels);
				ex.ui_upload(slot, width, height, x, y, w, h);
			}

			function context2d(width, height) {
				const c = document.createElement("canvas");
				c.width = width;
				c.height = height;
				return c.getContext("2d", { willReadFrequently: true });
			}

			// Draw the headline + tagline exactly where the HTML lays them out
			// (at rest), in the same system font, at the render resolution cap.
			function rasterizeHeadline(ex) {
				const dpr = deviceScale();
				const els = [heading, tagline];
				const rects = [layout.heading, layout.tagline];
				const pad = 24;
				const left = Math.floor((Math.min(...rects.map((r) => r.x)) - pad) * dpr) / dpr;
				const top = Math.floor((Math.min(...rects.map((r) => r.y)) - pad) * dpr) / dpr;
				const right = Math.max(...rects.map((r) => r.x + r.w)) + pad;
				const bottom = Math.max(...rects.map((r) => r.y + r.h)) + pad;
				const ctx = context2d(Math.ceil((right - left) * dpr), Math.ceil((bottom - top) * dpr));
				ctx.scale(dpr, dpr);
				ctx.translate(-left, -top);
				ctx.fillStyle = "#fff";
				ctx.textAlign = "center";
				els.forEach((el, i) => {
					const cs = getComputedStyle(el);
					ctx.font = `${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
					if ("letterSpacing" in ctx) ctx.letterSpacing = cs.letterSpacing === "normal" ? "0px" : cs.letterSpacing;
					// The tagline's 0.7 lives in the stylesheet (inline fade aside).
					ctx.globalAlpha = el === tagline ? 0.7 : 1;
					const text = el.textContent.trim();
					const m = ctx.measureText(text);
					const ascent = m.fontBoundingBoxAscent;
					const descent = m.fontBoundingBoxDescent;
					const r = rects[i];
					ctx.fillText(text, r.x + r.w / 2, r.y + (r.h - ascent - descent) / 2 + ascent);
				});
				upload(ex, 0, ctx, left, top, ctx.canvas.width / dpr, ctx.canvas.height / dpr);
			}

			// Icon atlas: one square cell per social icon, rendered with headroom
			// for the hover scale so it stays crisp.
			function rasterizeIcons(ex) {
				const dpr = deviceScale();
				const cell = Math.ceil(layout.icons[0].w * 1.25 * dpr);
				const ctx = context2d(cell * iconLinks.length, cell);
				ctx.fillStyle = "#fff";
				iconLinks.forEach((a, i) => {
					ctx.setTransform(cell / 24, 0, 0, cell / 24, i * cell, 0);
					ctx.fill(new Path2D(a.querySelector("path").getAttribute("d")));
				});
				upload(ex, 1, ctx, 0, 0, 0, 0);
			}

			// ---- Per-frame ------------------------------------------------------

			function makeControls(i) {
				const frag = template.content.cloneNode(true);
				const remove = frag.querySelector(".remove");
				const stepper = frag.querySelector(".stepper");
				remove.dataset.index = stepper.dataset.index = i;
				for (const b of [remove, ...stepper.querySelectorAll("button")]) b.tabIndex = paused ? 0 : -1;
				bodyControls.append(frag);
				return { remove, stepper, output: stepper.querySelector("output"), x: NaN, y: NaN, r: NaN, mass: -1, shown: true };
			}

			function setPaused(p) {
				paused = p;
				root.classList.toggle("paused", p);
				springs.add.to = springs.body.to = p ? 1 : 0;
				springs.card.to = springs.lift.to = cardWanted() ? 1 : 0;
				springs.hint.to = hintWanted() ? 1 : 0;
				pauseBtn.setAttribute("aria-pressed", String(p));
				pauseBtn.setAttribute("aria-label", p ? "Resume simulation" : "Pause simulation");
				addBtn.tabIndex = p ? 0 : -1;
				for (const c of pool) {
					for (const b of [c.remove, ...c.stepper.querySelectorAll("button")]) b.tabIndex = p ? 0 : -1;
				}
				redraw(2);
			}

			// Glass shapes for this frame, compared with the last frame's so the
			// renderer is only told about changes. 7 floats per shape.
			const MAX_SHAPES = 8 + cardEls.length;
			let shapes = new Float32Array(MAX_SHAPES * 7);
			let lastShapes = new Float32Array(MAX_SHAPES * 7);
			let shapeCount = 0;
			let lastShapeCount = -1;
			// Pushes a w x h shape at (x, y) scaled by s about its center (or,
			// with originY = 1, its bottom edge). Off-screen shapes are dropped.
			function pushShape(x, y, w, h, radius, s, alpha, style, originY = 0.5) {
				if (alpha <= 0.002 || shapeCount >= MAX_SHAPES) return;
				const sw = w * s;
				const sh = h * s;
				x += (w - sw) / 2;
				y += (h - sh) * originY;
				if (y > layout.canvasH || y + sh < 0) return;
				const o = shapeCount++ * 7;
				shapes[o] = x;
				shapes[o + 1] = y;
				shapes[o + 2] = sw;
				shapes[o + 3] = sh;
				shapes[o + 4] = radius * s;
				shapes[o + 5] = alpha;
				shapes[o + 6] = style;
			}
			function flushShapes(ex) {
				let same = shapeCount === lastShapeCount;
				for (let i = 0; same && i < shapeCount * 7; i++) same = Math.abs(shapes[i] - lastShapes[i]) < 0.005;
				if (same) return;
				ex.glass_clear();
				for (let o = 0; o < shapeCount * 7; o += 7) {
					ex.glass_push(shapes[o], shapes[o + 1], shapes[o + 2], shapes[o + 3], shapes[o + 4], shapes[o + 5], shapes[o + 6]);
				}
				[shapes, lastShapes] = [lastShapes, shapes];
				lastShapeCount = shapeCount;
				redraw(1);
			}

			// Values last handed to the renderer, to skip unchanged calls.
			const sent = { heroY: NaN, heroAlpha: NaN, bodyAlpha: NaN, icons: iconLinks.map(() => [NaN, NaN]) };

			let dirty = true;
			let shownCard = null;
			let shownBody = null;
			let heroDom = false;

			function applyAnimations(ex, now) {
				const L = layout;
				const card = springs.card.x;
				const cardOpacity = clamp01(card);
				const cardScale = 0.96 + 0.04 * card;
				const cardY = (1 - card) * 14;
				setStyle(infoCard, "opacity", String(cardOpacity));
				setStyle(infoCard, "transform", `translateY(${cardY}px) scale(${cardScale})`);
				const cardVisible = cardOpacity > 0.002;
				if (cardVisible !== shownCard) {
					shownCard = cardVisible;
					infoCard.style.visibility = cardVisible ? "visible" : "hidden";
				}

				const add = springs.add.x;
				const addScale = (0.4 + 0.6 * add) * (1 - 0.12 * springs.pressAdd.x);
				setStyle(addBtn, "opacity", String(clamp01(add)));
				setStyle(addBtn, "transform", `scale(${addScale})`);
				setStyle(addBtn, "visibility", add > 0.002 ? "visible" : "hidden");
				const pauseScale = 1 - 0.12 * springs.pressPause.x;
				setStyle(pauseBtn, "transform", `scale(${pauseScale})`);

				const body = clamp01(springs.body.x);
				setStyle(bodyControls, "opacity", String(body));
				const bodyVisible = body > 0.002;
				if (bodyVisible !== shownBody) {
					shownBody = bodyVisible;
					bodyControls.style.visibility = bodyVisible ? "visible" : "hidden";
				}

				// Headline: the HTML copy keeps the hit areas in place (and shows
				// while scrolling); the renderer draws it otherwise.
				const lift = L.lift * springs.lift.x;
				const drift = heroDrift();
				const fade = heroFade();
				setStyle(main, "--hero-shift", `${lift}px`);
				setStyle(main, "--hero-drift", `${drift}px`);
				setStyle(main, "--hero-fade", fade.toFixed(3));
				const dom = scrolling && fade > 0;
				if (dom !== heroDom) {
					heroDom = dom;
					setClass("hero-dom", dom);
				}
				// Layout is in document coordinates; the renderer draws in viewport ones.
				const heroY = lift + drift - scrollY;
				const heroAlpha = heroDom ? 0 : fade;
				if (heroY !== sent.heroY || heroAlpha !== sent.heroAlpha) {
					sent.heroY = heroY;
					sent.heroAlpha = heroAlpha;
					ex.ui_offset(0, 0, heroY);
					ex.ui_alpha?.(0, heroAlpha);
					redraw(1);
				}
				springs.icons.forEach((s, i) => {
					const scale = 1 + 0.15 * s.x;
					const alpha = (0.8 + 0.2 * clamp01(s.x)) * heroAlpha;
					const last = sent.icons[i];
					if (scale === last[0] && (alpha === last[1]) && heroY === last[2]) return;
					last[0] = scale;
					last[1] = alpha;
					last[2] = heroY;
					const r = L.icons[i];
					const w = r.w * scale;
					const h = r.h * scale;
					ex.icon_set(i, r.x + (r.w - w) / 2, r.y + (r.h - h) / 2 + heroY, w, h, alpha);
					redraw(1);
				});
				if (body !== sent.bodyAlpha) {
					sent.bodyAlpha = body;
					ex.set_body_ui_alpha(body);
					redraw(1);
				}

				// Glass, back to front: panels (frosted), then the small controls
				// (clear). The renderer keeps that order per style.
				shapeCount = 0;
				pushShape(L.card.x, L.card.y + cardY, L.card.w, L.card.h, L.cardRadius, cardScale, cardOpacity, 1, 1);
				if (glassOn) applyShelf(now);
				pushShape(L.add.x, L.add.y, L.add.w, L.add.h, L.add.w / 2, addScale, clamp01(add), 0);
				pushShape(L.pause.x, L.pause.y, L.pause.w, L.pause.h, L.pause.w / 2, pauseScale, 1, 0);
				if (glassOn) {
					// The scroll pill bobs (as its CSS animation did) and fades out
					// once the page scrolls or the sim pauses. On touch it rests
					// while the page scrolls natively.
					const h = clamp01(springs.hint.x);
					const still = touchScroll && nativeMode;
					const bob = h > 0.002 && !still ? (-5 * (1 - Math.cos((2 * Math.PI * now) / 2600))) / 2 : 0;
					const hintScale = 1 - 0.06 * springs.pressHint.x;
					const r = L.hint;
					setStyle(hint, "opacity", String(h));
					setStyle(hint, "visibility", h > 0.002 ? "visible" : "hidden");
					// Fixed (or, on touch, in the page): placed in step with its glass.
					setStyle(hint, "translate", touchScroll ? (still ? "" : `0 ${bob.toFixed(2)}px`) : `0 ${(r.y + bob - scrollY).toFixed(2)}px`);
					setStyle(hint, "scale", hintScale === 1 ? "" : hintScale.toFixed(4));
					pushShape(r.x, r.y + bob - scrollY, r.w, r.h, r.h / 2, hintScale, h * glassMix(), 0);
				}
				flushShapes(ex);
			}

			// The shelf: reveal progress follows the CSS view() timeline it
			// replaces (`entry i*4%` to `cover 30% + i*4%`, linear), and each
			// project card is frosted glass that moves, fades, and scales with it.
			// The shelf itself is fixed and placed here from the same scroll
			// position as the glass, so the two never drift apart.
			//
			// On touch the shelf stays in the page and scrolls natively; its
			// reveal is CSS (scroll-driven, or the time-based fallback), and the
			// glass only follows it here while the page is at rest.
			function applyShelf(now) {
				const vh = viewportH;
				if (!touchScroll) setStyle(shelfContent, "transform", `translate3d(0, ${layout.shelfY - scrollY}px, 0)`);
				const timed = touchScroll && !viewTimeline;
				for (const r of layout.reveal) {
					const d = vh - (r.y - scrollY);
					const start = r.i * 0.04 * r.h;
					const end = (0.3 + r.i * 0.04) * (vh + r.h);
					const p = timed ? clamp01(springs.shelfReveal.x) : clamp01((d - start) / (end - start));
					if (p === r.p) continue;
					r.p = p;
					if (touchScroll) continue;
					setStyle(r.el, "opacity", p === 1 ? "" : String(p));
					setStyle(r.el, "transform", p === 1 ? "" : `translateY(${48 * (1 - p)}px)`);
				}
				const mix = glassMix();
				layout.cards.forEach((c, i) => {
					const hover = springs.cardHover[i].x;
					const scale = 1 - 0.02 * springs.cardPress[i].x;
					const lift = -2 * hover;
					setStyle(cardEls[i], "transform", hover === 0 && scale === 1 ? "" : `translateY(${lift}px) scale(${scale})`);
					const p = c.reveal ? c.reveal.p : 1;
					const y = c.y - scrollY + (c.reveal ? 48 * (1 - p) : 0) + lift;
					pushShape(c.x, y, c.w, c.h, c.radius, scale, p * mix, 1);
				});
			}

			// Body controls only need work while visible, and only for bodies
			// that moved (when paused, that's at most the one being dragged).
			function syncBodyControls(ex) {
				const n = ex.body_count();
				while (pool.length < n) pool.push(makeControls(pool.length));
				for (let i = 0; i < pool.length; i++) {
					const c = pool[i];
					const shown = i < n;
					if (shown !== c.shown) {
						c.shown = shown;
						c.remove.hidden = c.stepper.hidden = !shown;
					}
					if (!shown) continue;
					const x = ex.body_x(i);
					const y = ex.body_y(i);
					const r = ex.body_radius(i);
					if (x !== c.x || y !== c.y || r !== c.r) {
						c.x = x;
						c.y = y;
						c.r = r;
						const o = r * 0.72 + CTL_GAP;
						c.remove.style.transform = `translate3d(${x + o}px, ${y - o}px, 0) translate(-50%, -50%)`;
						c.stepper.style.transform = `translate3d(${x}px, ${y + r + CTL_GAP + STEPPER_H / 2}px, 0) translate(-50%, -50%)`;
					}
					const mass = ex.body_mass(i);
					if (mass !== c.mass) {
						c.mass = mass;
						c.output.textContent = massFormat.format(Math.round(mass));
					}
				}
			}

			// Frames the sim must still draw even if nothing else moves.
			let pendingFrames = 2;
			const redraw = (n) => (pendingFrames = Math.max(pendingFrames, n));
			let pointerDown = false;
			let lastTime = 0;
			let frameNo = 0;
			let lastRendered = false;
			const stats = { rendered: 0, skipped: 0 };

			function setScrolling(on) {
				scrolling = on;
				dirty = true;
			}

			// ---- Touch scrolling ------------------------------------------------
			// From the first touch (or scroll) until the page has been still for
			// a moment, everything that moves with it scrolls natively at the
			// display's rate: the HTML headline stands in for the drawn one, and
			// the shelf and pill wear CSS glass while the renderer's fades out.
			// Once still, the renderer's glass fades back in where they are.
			const glassMix = () => (touchScroll ? clamp01(springs.glassMix.x) : 1);
			function enterNative() {
				if (!touchScroll || nativeMode) return;
				nativeMode = true;
				setClass("scroll-native", true);
				const g = springs.glassMix;
				g.x = g.to = g.v = 0;
				setScrolling(true);
				if (live && layout) applyAnimations(window.wasm_exports, performance.now());
			}
			function settleNative(now) {
				if (!nativeMode || touchActive || now - lastScrollEvent < NATIVE_SETTLE_MS) return;
				if (scrollY < 0 || scrollY > layout.maxScroll + 1) return;
				nativeMode = false;
				setClass("scroll-native", false);
				springs.glassMix.to = 1;
				setScrolling(false);
			}

			// Runs before each sim frame (mq_before_frame). Returning false
			// skips the sim's frame: no physics, no GL calls, last image stays.
			function beforeFrame() {
				const ex = window.wasm_exports;
				const now = performance.now();
				const interval = now - lastTime;
				const dt = Math.min(interval / 1000 || 0, 1 / 30);
				lastTime = now;
				frameNo++;

				// Scroll position: read once, before this frame writes anything.
				const sy = window.scrollY;
				if (sy !== scrollY) {
					scrollY = sy;
					onScrollMoved();
				}
				if (touchScroll) {
					settleNative(now);
					springs.shelfReveal.to = viewTimeline || !shelf.classList.contains("io-reveal") || shelf.classList.contains("in-view") ? 1 : 0;
				} else {
					const isScrolling = now - lastScrollEvent < SCROLL_SETTLE_MS;
					if (isScrolling !== scrolling) setScrolling(isScrolling);
				}

				const p = ex.is_paused() !== 0;
				if (p !== paused) setPaused(p);

				let moving = false;
				for (const s of SPRINGS) moving = step(s, dt) || moving;
				// The pill's bob is a continuous animation while it's shown.
				if (glassOn && springs.hint.x > 0.002) moving = true;
				if (moving || dirty) {
					dirty = false;
					applyAnimations(ex, now);
				}

				// Decide whether the sim draws this frame.
				let render = true;
				if (pendingFrames > 0) pendingFrames--;
				else if (paused) render = pointerDown;
				// Touch scrolling: the renderer draws nothing that moves with the
				// page, so planets at half rate leave the GPU to the scroll.
				else if (touchScroll && nativeMode) render = frameNo % 2 === 0;
				// Hero scrolled away and nothing touched: half rate is plenty for
				// planets drifting behind the shelf.
				else if (!scrolling && !pointerDown && heroFade() === 0) render = frameNo % 2 === 0;

				if (render && lastRendered) checkBudget(now, interval);
				lastRendered = render;
				stats[render ? "rendered" : "skipped"]++;
				return render;
			}

			// Runs right after the sim's frame, so body controls track the
			// bodies it just moved.
			function afterFrame() {
				if (springs.body.x > 0.002) syncBodyControls(window.wasm_exports);
			}

			let rasterizeQueued = false;
			function relayout() {
				const ex = window.wasm_exports;
				rasterizeQueued = false;
				appliedScale = 0;
				applyScale();
				measure();
				rasterizeHeadline(ex);
				rasterizeIcons(ex);
				redraw(2);
			}

			let tries = 0;
			async function start() {
				const ex = window.wasm_exports;
				// Wait until the sim has run a frame and the system font is ready
				// (give up after ~20s: the HTML fallback stays).
				if (!ex?.ui_upload || ex.body_count() === 0) {
					if (++tries < 400) setTimeout(start, 50);
					return;
				}
				await document.fonts.ready;
				root.classList.add("sim-live");
				relayout();
				live = true;
				window.mq_before_frame = beforeFrame;
				window.mq_after_frame = afterFrame;
				window.simStats = stats;
				// For debugging and the perf/visual checks: the render scale and
				// the glass shapes last sent to the renderer.
				Object.defineProperty(stats, "scale", { get: () => appliedScale, enumerable: true });
				stats.shapes = () => Array.from(lastShapes.subarray(0, Math.max(0, lastShapeCount) * 7));
				stats.budget = budget;
				// Give the renderer two frames to pick up the textures before
				// the canvas fades in over the HTML headline it replaces. From
				// then on it also draws the shelf's glass.
				requestAnimationFrame(() =>
					requestAnimationFrame(() => {
						// Place the shelf and pill before they turn fixed.
						glassOn = true;
						applyAnimations(window.wasm_exports, performance.now());
						root.classList.add("sim-ready", "sim-glass");
						dirty = true;
					}),
				);
			}
			if (!reduce) start();

			window.addEventListener("resize", () => {
				if (rasterizeQueued || !layout) return;
				rasterizeQueued = true;
				requestAnimationFrame(relayout);
			});

			pauseBtn.addEventListener("click", () => {
				window.wasm_exports?.set_paused(paused ? 0 : 1);
				setPaused(!paused);
			});
			addBtn.addEventListener("click", () => {
				window.wasm_exports?.add_body();
				redraw(2);
			});

			// Press feedback (the glass squishes slightly, then springs back).
			for (const [el, s] of [[pauseBtn, springs.pressPause], [addBtn, springs.pressAdd], [hint, springs.pressHint]]) {
				el.addEventListener("pointerdown", () => (s.to = 1));
				for (const type of ["pointerup", "pointerleave", "pointercancel"]) el.addEventListener(type, () => (s.to = 0));
			}
			iconLinks.forEach((a, i) => {
				a.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && (springs.icons[i].to = 1));
				a.addEventListener("pointerleave", () => (springs.icons[i].to = 0));
			});
			// A focused card is fixed, so the browser won't scroll to it: bring
			// it on screen the way focus would.
			shelf.addEventListener("focusin", (e) => {
				const i = cardEls.indexOf(e.target.closest(".project-card"));
				if (!glassOn || i < 0) return;
