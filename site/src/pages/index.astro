				border-bottom: 1.5px solid currentColor;
			}
			.frac > :last-child {
				padding-top: 2px;
			}
			.formula-label {
				font-size: 13px;
				font-weight: 500;
				color: var(--label-tertiary);
				text-align: right;
				transition: color 0.15s ease;
			}
			@media (hover: hover) {
				.formula:hover .formula-label {
					color: var(--label);
				}
			}
			.formula:active .formula-label {
				color: var(--label);
			}
			/* Rounds the shared focus ring (.sim-ui a:focus-visible). */
			.formula {
				border-radius: 8px;
			}

			/* ---- Scroll hint ---- */
			.scroll-hint {
				position: absolute;
				z-index: 2;
				left: 50%;
				top: calc(100vh - 74px);
				top: calc(100svh - 74px - var(--lg-safe-bottom));
				display: flex;
				align-items: center;
				gap: 6px;
				box-sizing: border-box;
				height: 38px;
				padding: 0 14px 0 17px;
				border-radius: var(--lg-radius-pill);
				color: var(--label);
				font-size: 15px;
				font-weight: 500;
				line-height: 20px;
				letter-spacing: -0.2px;
				text-decoration: none;
				transform: translateX(-50%);
				transition: opacity 0.3s ease, visibility 0.3s;
			}
			.scroll-hint svg {
				width: 16px;
				height: 16px;
				fill: none;
				stroke: currentColor;
				stroke-width: 2.25;
				stroke-linecap: round;
				stroke-linejoin: round;
			}
			.scroll-hint::after {
				content: "";
				position: absolute;
				inset: -3px 0;
				border-radius: inherit;
			}
			.scroll-hint:focus-visible {
				outline: 2px solid #fff;
				outline-offset: 3px;
			}
			html:not(.sim-glass) .scroll-hint:active {
				scale: 0.96;
				transition: scale 0.15s ease;
			}
			.scrolled .scroll-hint,
			.paused .scroll-hint {
				opacity: 0;
				visibility: hidden;
			}
			@media (prefers-reduced-motion: no-preference) {
				.scroll-hint {
					animation: hint-bob 2.6s ease-in-out infinite;
				}
			}
			@keyframes hint-bob {
				0%,
				100% {
					translate: 0 0;
				}
				50% {
					translate: 0 -5px;
				}
			}

			/* ---- Projects shelf ----
			   Sits right below the first screen. The bottom padding lets it
			   scroll up to the middle of the viewport. */
			.shelf {
				--shelf-h: 114px;
				position: relative;
				z-index: 2;
				box-sizing: border-box;
				padding-bottom: calc(50vh - var(--shelf-h) / 2);
				padding-bottom: calc(50svh - var(--shelf-h) / 2);
				/* Let drags on empty space reach the sim behind. */
				pointer-events: none;
				/* The cards' refraction layer (SVG fallback) reaches past them to
				   sample light at the rim; keep that from widening the page. */
				overflow-x: clip;
			}
			.shelf-content {
				box-sizing: border-box;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 16px;
				padding: 0 24px;
				padding: 0 max(24px, var(--lg-safe-right)) 0 max(24px, var(--lg-safe-left));
			}
			.shelf h2 {
				margin: 0;
			}
			.shelf-grid {
				display: grid;
				grid-template-columns: repeat(2, 380px);
				gap: 16px;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.shelf-grid > li {
				display: flex;
				pointer-events: auto;
			}
			/* A reserved slot, not a disabled card: a soft hairline outline (no
			   fill, so it never reads as a control) and legible label. */
			.more-soon {
				display: grid;
				place-items: center;
				box-sizing: border-box;
				width: 100%;
				min-height: 84px;
				border: 1px dashed rgba(255, 255, 255, 0.28);
				border-radius: var(--lg-radius-lg);
				color: var(--lg-label-secondary);
				font-size: 15px;
				font-weight: 500;
				line-height: 20px;
				letter-spacing: -0.2px;
				cursor: default;
				-webkit-user-select: none;
				user-select: none;
			}
			@media (max-width: 820px) {
				.shelf {
					--shelf-h: 214px;
				}
				.shelf-grid {
					grid-template-columns: minmax(0, 420px);
					justify-content: center;
					width: 100%;
				}
			}
			/* Phones: the same 20px gutters as the project page, so a card's
			   tagline stays on one line (and its icon concentric) from 375px. */
			@media (max-width: 699px) {
				.shelf-content {
					padding-left: max(20px, var(--lg-safe-left));
					padding-right: max(20px, var(--lg-safe-right));
				}
			}

			/* Reveal: rises in as it scrolls into view. Scroll-driven where
			   supported; otherwise .io-reveal + .in-view (IntersectionObserver). */
			@keyframes shelf-rise {
				from {
					opacity: 0;
					transform: translateY(48px);
				}
				to {
					opacity: 1;
					transform: none;
				}
			}
			@media (prefers-reduced-motion: no-preference) {
				@supports (animation-timeline: view()) {
					.shelf .reveal {
						animation: shelf-rise linear both;
						animation-timeline: view();
						/* Staggered by shifting each item's range a little. */
						animation-range: entry calc(var(--i) * 4%) cover calc(30% + var(--i) * 4%);
					}
				}
				.io-reveal .reveal {
					opacity: 0;
					transform: translateY(48px);
					transition:
						opacity 0.6s var(--lg-ease-out),
						transform 0.8s var(--lg-ease-out);
					transition-delay: calc(var(--i) * 60ms);
				}
				.io-reveal.in-view .reveal {
					opacity: 1;
					transform: none;
				}
			}
		</style>
</BaseLayout>
