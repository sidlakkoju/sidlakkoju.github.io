---
const name = "Sid Lakkoju";
const siteUrl = "https://sidlakkoju.github.io/";
const title = name;
const description =
	"Sid Lakkoju is an engineer at SpaceX. Personal site with links to Sid's YouTube, GitHub, and LinkedIn, plus an interactive three-body gravity simulation.";
const ogImage = new URL("/og.png", siteUrl).href;

const profiles = {
	youtube: "https://www.youtube.com/@SidLakkoju",
	github: "https://github.com/sidlakkoju",
	linkedin: "https://www.linkedin.com/in/sidlakkoju/",
};

// One linked graph so search engines can tie the person, the site, and the
// profile page together (and to the sameAs profiles for the knowledge panel).
const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Person",
			"@id": `${siteUrl}#person`,
			name,
			givenName: "Sid",
			familyName: "Lakkoju",
			url: siteUrl,
			jobTitle: "Engineer",
			worksFor: {
				"@type": "Organization",
				name: "SpaceX",
				url: "https://www.spacex.com/",
				sameAs: "https://en.wikipedia.org/wiki/SpaceX",
			},
			sameAs: Object.values(profiles),
		},
		{
			"@type": "WebSite",
			"@id": `${siteUrl}#website`,
			url: siteUrl,
			name,
			inLanguage: "en",
			publisher: { "@id": `${siteUrl}#person` },
		},
		{
			"@type": "ProfilePage",
			"@id": `${siteUrl}#profilepage`,
			url: siteUrl,
			name: title,
			description,
			inLanguage: "en",
			isPartOf: { "@id": `${siteUrl}#website` },
			mainEntity: { "@id": `${siteUrl}#person` },
			primaryImageOfPage: { "@type": "ImageObject", url: ogImage, width: 1200, height: 630 },
		},
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={name} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="canonical" href={siteUrl} />
		<meta name="theme-color" content="#000000" />
		<meta name="color-scheme" content="dark" />
		<meta name="generator" content={Astro.generator} />

		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" type="application/xml" href="/sitemap.xml" />

		{Object.values(profiles).map((href) => <link rel="me" href={href} />)}

		<meta property="og:type" content="profile" />
		<meta property="og:site_name" content={name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Sid Lakkoju, with three orbiting planets" />
		<meta property="profile:first_name" content="Sid" />
		<meta property="profile:last_name" content="Lakkoju" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<link rel="preload" href="/sim/gravity_simulation.wasm" as="fetch" type="application/wasm" crossorigin />

		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body>
		<canvas id="glcanvas" tabindex="0" aria-label="Interactive three-body gravity simulation"></canvas>

		<!-- Once the sim is running, the renderer draws this headline and the
		     icons itself (from pixels rasterized below) so the glass can refract
		     them. The HTML stays underneath as the accessible/indexable copy and
		     as the fallback when WebGL or motion is unavailable. -->
		<main>
			<h1>{name}</h1>
			<p>Nerd @SpaceX 🚀</p>

			<nav class="social-links" aria-label="Social links">
				<a href={profiles.youtube} target="_blank" rel="me noopener noreferrer" aria-label="Sid Lakkoju on YouTube">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
					</svg>
				</a>
				<a href={profiles.github} target="_blank" rel="me noopener noreferrer" aria-label="Sid Lakkoju on GitHub">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
					</svg>
				</a>
				<a href={profiles.linkedin} target="_blank" rel="me noopener noreferrer" aria-label="Sid Lakkoju on LinkedIn">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
					</svg>
				</a>
			</nav>
		</main>

		<!-- Glass UI. Elements marked .glass are drawn by the renderer as
		     refractive glass at their on-screen rect; the HTML only provides the
		     content, layout, and hit areas. -->
		<div class="sim-ui">
			<div class="sim-buttons">
				<button id="add-btn" class="glass glass-btn" aria-label="Add planet" tabindex="-1">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5.5v13M5.5 12h13" /></svg>
				</button>
				<button id="pause-btn" class="glass glass-btn" aria-label="Pause simulation" aria-pressed="false">
					<svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 7v10M15 7v10" /></svg>
					<svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path class="fill" d="M8.75 6.9v10.2a.9.9 0 0 0 1.38.76l8.03-5.1a.9.9 0 0 0 0-1.52l-8.03-5.1a.9.9 0 0 0-1.38.76Z" /></svg>
				</button>
			</div>

			<div id="body-controls"></div>

			<aside id="sim-info" class="glass glass-panel" aria-live="polite">
				<h2>The three-body problem</h2>
				<p>
					There's no general closed-form solution. Even tiny differences in starting
					conditions lead to wildly different orbits.
				</p>
				<a class="formula" href="https://en.wikipedia.org/wiki/Newton%27s_law_of_universal_gravitation" target="_blank" rel="noopener noreferrer">
					<span class="math" aria-label="F g equals G times m 1 m 2 over d squared">
						<span>F<sub>g</sub></span>
						<span class="op">=</span>
						<span>G</span>
						<span class="frac">
							<span>m<sub>1</sub>m<sub>2</sub></span>
							<span>d<sup>2</sup></span>
						</span>
					</span>
					<span class="formula-label">Newton's law of gravitation <span aria-hidden="true">↗</span></span>
				</a>
				<p>i think this is super cool - you should watch the netflix show.</p>
				<p class="hint">Drag a planet to move it. Drag its arrow to change its velocity.</p>
			</aside>
		</div>

		<!-- Sizes must match CTL_* in gravity_simulation/src/main.rs. -->
		<template id="body-ctl-template">
			<button class="remove" data-action="remove" aria-label="Remove planet" tabindex="-1">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 8l8 8M16 8l-8 8" /></svg>
			</button>
			<div class="stepper">
				<button data-action="lighter" aria-label="Decrease mass" tabindex="-1">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 12h11" /></svg>
				</button>
				<output aria-label="Mass"></output>
				<button data-action="heavier" aria-label="Increase mass" tabindex="-1">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 6.5v11M6.5 12h11" /></svg>
				</button>
			</div>
		</template>

		<script>
			import { animateFavicon } from "../favicon.js";
			animateFavicon();
		</script>

		<script is:inline src="/sim/mq_js_bundle.js"></script>
		<script is:inline>
		// Wrapped in a function so these names can't collide with
		// mq_js_bundle.js's top-level globals (it already declares `canvas`).
		// A function, not a bare block: iOS 17 Safari mis-scopes async
		// function declarations inside blocks.
		(() => {
			// macroquad's shim exposes `load(path)` once mq_js_bundle.js has run.
			// Honor prefers-reduced-motion by skipping the sim entirely.
			const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			if (!reduce) {
				load("/sim/gravity_simulation.wasm");
			} else {
				document.getElementById("glcanvas").style.display = "none";
			}

			const root = document.documentElement;
			const canvas = document.getElementById("glcanvas");
			const heading = document.querySelector("main h1");
			const tagline = document.querySelector("main p");
			const nav = document.querySelector(".social-links");
			const iconLinks = [...nav.querySelectorAll("a")];
			const pauseBtn = document.getElementById("pause-btn");
			const addBtn = document.getElementById("add-btn");
			const infoCard = document.getElementById("sim-info");
			const bodyControls = document.getElementById("body-controls");
			const template = document.getElementById("body-ctl-template");
			const massFormat = new Intl.NumberFormat("en-US");

			// Must match CTL_* in main.rs so the HTML lands on the drawn glass.
			const CTL_GAP = 14;
			const STEPPER_H = 32;

			// Performance model: nothing in the per-frame loop reads layout or
			// computed styles. Layout is measured once (and on resize), every
			// animation is a spring computed here, and the DOM and the renderer
			// are only written when a value actually changes.

			let paused = false;
			let layout = null;
			const pool = []; // per-body controls; pool[i] belongs to body i

			// ---- Springs --------------------------------------------------------

			const springs = {
				card: { x: 0, v: 0, to: 0 },
				add: { x: 0, v: 0, to: 0 },
				body: { x: 0, v: 0, to: 0 },
				lift: { x: 0, v: 0, to: 0 },
				pressPause: { x: 0, v: 0, to: 0 },
				pressAdd: { x: 0, v: 0, to: 0 },
				icons: iconLinks.map(() => ({ x: 0, v: 0, to: 0 })),
			};
			const allSprings = () => [springs.card, springs.add, springs.body, springs.lift, springs.pressPause, springs.pressAdd, ...springs.icons];

			// Slightly underdamped (damping ratio ~0.85), ~0.4s settle: a soft
			// Apple-style spring with a hint of overshoot.
			function step(s, dt) {
				if (s.x === s.to && s.v === 0) return false;
				s.v += (260 * (s.to - s.x) - 27 * s.v) * dt;
				s.x += s.v * dt;
				if (Math.abs(s.to - s.x) < 5e-4 && Math.abs(s.v) < 5e-3) {
					s.x = s.to;
					s.v = 0;
				}
				return true;
			}
			const clamp01 = (x) => Math.min(1, Math.max(0, x));

			// ---- Layout ---------------------------------------------------------

			function rectOf(el) {
				const r = el.getBoundingClientRect();
				return { x: r.left, y: r.top, w: r.width, h: r.height };
			}

			// Measure everything at rest (transforms off) in one forced layout.
			function measure() {
				root.classList.add("measuring");
				layout = {
					pause: rectOf(pauseBtn),
					add: rectOf(addBtn),
					card: rectOf(infoCard),
					cardRadius: parseFloat(getComputedStyle(infoCard).borderTopLeftRadius),
					heading: rectOf(heading),
					tagline: rectOf(tagline),
					nav: rectOf(nav),
					icons: iconLinks.map((a) => rectOf(a.querySelector("svg"))),
				};
				root.classList.remove("measuring");
				// While the card is up, lift the headline just enough to clear it,
				// but never under the top buttons.
				const needed = layout.card.y - 20 - (layout.nav.y + layout.nav.h);
				layout.lift = Math.max(Math.min(0, needed), -(layout.heading.y - 80));
				dirty = true;
			}

			// ---- Pixel upload into the renderer -------------------------------

			function upload(ex, slot, ctx, x, y, w, h) {
				const { width, height } = ctx.canvas;
				const pixels = ctx.getImageData(0, 0, width, height).data;
				const ptr = ex.ui_alloc(pixels.length);
				// Read the buffer after ui_alloc: allocating may grow wasm memory.
				new Uint8Array(wasm_memory.buffer, ptr, pixels.length).set(pixels);
				ex.ui_upload(slot, width, height, x, y, w, h);
			}

			function context2d(width, height) {
				const c = document.createElement("canvas");
				c.width = width;
				c.height = height;
				return c.getContext("2d", { willReadFrequently: true });
			}

			// Draw the headline + tagline exactly where the HTML lays them out
			// (at rest), in the same system font, at device resolution.
			function rasterizeHeadline(ex) {
				const dpr = window.devicePixelRatio || 1;
				const els = [heading, tagline];
				const rects = [layout.heading, layout.tagline];
				const pad = 24;
				const left = Math.floor((Math.min(...rects.map((r) => r.x)) - pad) * dpr) / dpr;
				const top = Math.floor((Math.min(...rects.map((r) => r.y)) - pad) * dpr) / dpr;
				const right = Math.max(...rects.map((r) => r.x + r.w)) + pad;
				const bottom = Math.max(...rects.map((r) => r.y + r.h)) + pad;
				const ctx = context2d(Math.ceil((right - left) * dpr), Math.ceil((bottom - top) * dpr));
				ctx.scale(dpr, dpr);
				ctx.translate(-left, -top);
				ctx.fillStyle = "#fff";
				ctx.textAlign = "center";
				els.forEach((el, i) => {
					const cs = getComputedStyle(el);
					ctx.font = `${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
					if ("letterSpacing" in ctx) ctx.letterSpacing = cs.letterSpacing === "normal" ? "0px" : cs.letterSpacing;
					ctx.globalAlpha = parseFloat(cs.opacity);
					const text = el.textContent.trim();
					const m = ctx.measureText(text);
					const ascent = m.fontBoundingBoxAscent;
					const descent = m.fontBoundingBoxDescent;
					const r = rects[i];
					ctx.fillText(text, r.x + r.w / 2, r.y + (r.h - ascent - descent) / 2 + ascent);
				});
				upload(ex, 0, ctx, left, top, ctx.canvas.width / dpr, ctx.canvas.height / dpr);
			}

			// Icon atlas: one square cell per social icon, rendered with headroom
			// for the hover scale so it stays crisp.
			function rasterizeIcons(ex) {
				const dpr = window.devicePixelRatio || 1;
				const cell = Math.ceil(layout.icons[0].w * 1.25 * dpr);
				const ctx = context2d(cell * iconLinks.length, cell);
				ctx.fillStyle = "#fff";
				iconLinks.forEach((a, i) => {
					ctx.setTransform(cell / 24, 0, 0, cell / 24, i * cell, 0);
					ctx.fill(new Path2D(a.querySelector("path").getAttribute("d")));
				});
				upload(ex, 1, ctx, 0, 0, 0, 0);
			}

			// ---- Per-frame ------------------------------------------------------

			function makeControls(i) {
				const frag = template.content.cloneNode(true);
				const remove = frag.querySelector(".remove");
				const stepper = frag.querySelector(".stepper");
				remove.dataset.index = stepper.dataset.index = i;
				for (const b of [remove, ...stepper.querySelectorAll("button")]) b.tabIndex = paused ? 0 : -1;
				bodyControls.append(frag);
				return { remove, stepper, output: stepper.querySelector("output"), x: NaN, y: NaN, r: NaN, mass: -1, shown: true };
			}

			function setPaused(p) {
				paused = p;
				root.classList.toggle("paused", p);
				springs.card.to = springs.add.to = springs.body.to = springs.lift.to = p ? 1 : 0;
				pauseBtn.setAttribute("aria-pressed", String(p));
				pauseBtn.setAttribute("aria-label", p ? "Resume simulation" : "Pause simulation");
				addBtn.tabIndex = p ? 0 : -1;
				for (const c of pool) {
					for (const b of [c.remove, ...c.stepper.querySelectorAll("button")]) b.tabIndex = p ? 0 : -1;
				}
			}

			// Glass shape about a rect's center (or bottom edge), scaled.
			function scaled(r, s, originY = 0.5, dy = 0) {
				const w = r.w * s;
				const h = r.h * s;
				return [r.x + (r.w - w) / 2, r.y + (r.h - h) * originY + dy, w, h];
			}

			let dirty = true;
			let lastGlass = "";
			let lastTime = 0;
			let shownCard = null;
			let shownBody = null;

			function applyAnimations(ex) {
				const L = layout;
				const card = springs.card.x;
				const cardOpacity = clamp01(card);
				const cardScale = 0.96 + 0.04 * card;
				const cardY = (1 - card) * 14;
				infoCard.style.opacity = cardOpacity;
				infoCard.style.transform = `translateY(${cardY}px) scale(${cardScale})`;
				const cardVisible = cardOpacity > 0.002;
				if (cardVisible !== shownCard) {
					shownCard = cardVisible;
					infoCard.style.visibility = cardVisible ? "visible" : "hidden";
				}

				const add = springs.add.x;
				const addScale = (0.4 + 0.6 * add) * (1 - 0.12 * springs.pressAdd.x);
				addBtn.style.opacity = clamp01(add);
				addBtn.style.transform = `scale(${addScale})`;
				addBtn.style.visibility = add > 0.002 ? "visible" : "hidden";
				const pauseScale = 1 - 0.12 * springs.pressPause.x;
				pauseBtn.style.transform = `scale(${pauseScale})`;

				const body = clamp01(springs.body.x);
				bodyControls.style.opacity = body;
				const bodyVisible = body > 0.002;
				if (bodyVisible !== shownBody) {
					shownBody = bodyVisible;
					bodyControls.style.visibility = bodyVisible ? "visible" : "hidden";
				}

				const lift = L.lift * springs.lift.x;
				root.style.setProperty("--hero-shift", `${lift}px`);
				ex.ui_offset(0, 0, lift);
				springs.icons.forEach((s, i) => {
					const [x, y, w, h] = scaled(L.icons[i], 1 + 0.15 * s.x, 0.5, lift);
					ex.icon_set(i, x, y, w, h, 0.8 + 0.2 * clamp01(s.x));
				});
				ex.set_body_ui_alpha(body);

				// Glass, back to front: card, then the small controls.
				const shapes = [];
				if (cardOpacity > 0) shapes.push([...scaled(L.card, cardScale, 1, cardY), L.cardRadius * cardScale, cardOpacity, 1]);
				if (add > 0.002) {
					const r = scaled(L.add, addScale);
					shapes.push([...r, r[2] / 2, clamp01(add), 0]);
				}
				const pr = scaled(L.pause, pauseScale);
				shapes.push([...pr, pr[2] / 2, 1, 0]);
				const key = shapes.map((s) => s.map((v) => v.toFixed(2)).join(",")).join(";");
				if (key !== lastGlass) {
					lastGlass = key;
					ex.glass_clear();
					for (const s of shapes) ex.glass_push(...s);
				}
			}

			// Body controls only need work while visible, and only for bodies
			// that moved (when paused, that's at most the one being dragged).
			function syncBodyControls(ex) {
				const n = ex.body_count();
				while (pool.length < n) pool.push(makeControls(pool.length));
				for (let i = 0; i < pool.length; i++) {
					const c = pool[i];
					const shown = i < n;
					if (shown !== c.shown) {
						c.shown = shown;
						c.remove.hidden = c.stepper.hidden = !shown;
					}
					if (!shown) continue;
					const x = ex.body_x(i);
					const y = ex.body_y(i);
					const r = ex.body_radius(i);
					if (x !== c.x || y !== c.y || r !== c.r) {
						c.x = x;
						c.y = y;
						c.r = r;
						const o = r * 0.72 + CTL_GAP;
						c.remove.style.transform = `translate3d(${x + o}px, ${y - o}px, 0) translate(-50%, -50%)`;
						c.stepper.style.transform = `translate3d(${x}px, ${y + r + CTL_GAP + STEPPER_H / 2}px, 0) translate(-50%, -50%)`;
					}
					const mass = ex.body_mass(i);
					if (mass !== c.mass) {
						c.mass = mass;
						c.output.textContent = massFormat.format(Math.round(mass));
					}
				}
			}

			// Runs right after macroquad's own rAF callback each frame (it's
			// started once wasm is up, so it's queued behind the sim), so body
			// controls track the bodies the sim just drew. Glass shapes pushed
			// here are drawn next frame, which is invisible for these animations.
			function frame(now) {
				const ex = window.wasm_exports;
				const dt = Math.min((now - lastTime) / 1000 || 0, 1 / 30);
				lastTime = now;

				const p = ex.is_paused() !== 0;
				if (p !== paused) setPaused(p);

				let moving = false;
				for (const s of allSprings()) moving = step(s, dt) || moving;
				if (moving || dirty) {
					dirty = false;
					applyAnimations(ex);
				}
				if (springs.body.x > 0.002) syncBodyControls(ex);
				requestAnimationFrame(frame);
			}

			let rasterizeQueued = false;
			function relayout() {
				const ex = window.wasm_exports;
				rasterizeQueued = false;
				measure();
				rasterizeHeadline(ex);
				rasterizeIcons(ex);
			}

			async function start() {
				const ex = window.wasm_exports;
				// Wait until the sim has run a frame and the system font is ready.
				if (!ex?.ui_upload || ex.body_count() === 0) {
					setTimeout(start, 50);
					return;
				}
				await document.fonts.ready;
				root.classList.add("sim-live");
				relayout();
				requestAnimationFrame(frame);
				// Give the renderer two frames to pick up the textures before
				// the canvas fades in over the HTML headline it replaces.
				requestAnimationFrame(() => requestAnimationFrame(() => root.classList.add("sim-ready")));
			}
			if (!reduce) start();

			window.addEventListener("resize", () => {
				if (rasterizeQueued || !layout) return;
				rasterizeQueued = true;
				requestAnimationFrame(relayout);
			});

			pauseBtn.addEventListener("click", () => {
				window.wasm_exports?.set_paused(paused ? 0 : 1);
				setPaused(!paused);
			});
			addBtn.addEventListener("click", () => window.wasm_exports?.add_body());

			// Press feedback (the glass squishes slightly, then springs back).
			for (const [el, s] of [[pauseBtn, springs.pressPause], [addBtn, springs.pressAdd]]) {
				el.addEventListener("pointerdown", () => (s.to = 1));
				for (const type of ["pointerup", "pointerleave", "pointercancel"]) el.addEventListener(type, () => (s.to = 0));
			}
			iconLinks.forEach((a, i) => {
				a.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && (springs.icons[i].to = 1));
				a.addEventListener("pointerleave", () => (springs.icons[i].to = 0));
			});

			bodyControls.addEventListener("click", (e) => {
				const btn = e.target.closest("[data-action]");
				const ex = window.wasm_exports;
				if (!btn || !ex) return;
				const i = Number(btn.closest("[data-index]").dataset.index);
				if (btn.dataset.action === "remove") ex.remove_body(i);
				else ex.step_mass(i, btn.dataset.action === "heavier" ? 1 : -1);
			});

			// Clicking a control shouldn't steal focus from the canvas, or Space
			// (pause) would start activating whichever button was clicked last.
			document.querySelector(".sim-ui").addEventListener("mousedown", (e) => {
				if (e.target.closest("button")) e.preventDefault();
			});

			// macroquad only listens for mouseup on the canvas, so a drag released
			// over a control would never end. Let pointers fall through to the
			// canvas for the duration of a drag.
			canvas.addEventListener("pointerdown", () => root.classList.add("dragging"));
			window.addEventListener("pointerup", () => root.classList.remove("dragging"));
			window.addEventListener("pointercancel", () => root.classList.remove("dragging"));
		})();
		</script>

		<style is:global>
			:root {
				--ease-spring: cubic-bezier(0.32, 0.72, 0, 1);
				--label: #fff;
				--label-secondary: rgba(255, 255, 255, 0.82);
				--label-tertiary: rgba(255, 255, 255, 0.62);
				--separator: rgba(255, 255, 255, 0.16);
				--font-text: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Inter", "Segoe UI Variable Text", "Segoe UI", system-ui, sans-serif;
				--font-display: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Inter", "Segoe UI Variable Display", "Segoe UI", system-ui, sans-serif;
				--safe-top: env(safe-area-inset-top, 0px);
				--safe-right: env(safe-area-inset-right, 0px);
				--safe-bottom: env(safe-area-inset-bottom, 0px);
				--safe-left: env(safe-area-inset-left, 0px);
			}

			html, body {
				margin: 0;
				padding: 0;
				height: 100%;
				background: #000;
				color: var(--label);
				font-family: var(--font-text);
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
				-webkit-tap-highlight-color: transparent;
				overflow: hidden;
			}

			#glcanvas {
				position: fixed;
				inset: 0;
				width: 100%;
				height: 100%;
				display: block;
				/* Above the HTML headline: once running, the renderer draws the
				   headline itself so glass can refract it. Transparent until then. */
				z-index: 1;
				opacity: 0;
				transition: opacity 0.5s ease;
				/* macroquad calls canvas.focus() on startup so it gets key events;
				   without this the browser draws its focus ring around the page. */
				outline: none;
				/* Disable native touch gestures so drag interactions aren't
				   hijacked by the browser's scroll/pinch on mobile. */
				touch-action: none;
			}
			.sim-ready #glcanvas {
				opacity: 1;
			}

			/* No z-index here on purpose: the headline paints below the canvas
			   while the social links (positioned, z-index 2) stay clickable. */
			main {
				position: relative;
				min-height: 100vh;
				min-height: 100dvh;
				padding: 0 24px;
				box-sizing: border-box;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				text-align: center;
				pointer-events: none;
			}

			main h1 {
				margin: 0;
				font-family: var(--font-display);
				font-size: clamp(2.5rem, 8vw, 6rem);
				font-weight: 600;
				letter-spacing: -0.03em;
				mix-blend-mode: difference;
			}

			/* Lifted by the page script (a spring) while the info card is up. */
			main > * {
				transform: translateY(var(--hero-shift, 0px));
			}

			main p {
				margin: 0.5rem 0 0;
				font-size: clamp(0.95rem, 2vw, 1.1rem);
				opacity: 0.7;
				mix-blend-mode: difference;
			}

			/* Positioned above the canvas so the links stay clickable. */
			.social-links {
				position: relative;
				z-index: 2;
				display: flex;
				justify-content: center;
				gap: 2rem;
				margin-top: 1.5rem;
			}

			.social-links a {
				display: flex;
				color: #fff;
				opacity: 0.8;
				border-radius: 6px;
				transition: transform 0.45s var(--ease-spring), opacity 0.2s ease;
				/* Re-enable clicks; parent <main> sets pointer-events: none
				   so canvas drags can pass through to the sim. */
				pointer-events: auto;
			}
			/* Once the sim runs, the renderer draws the icons and animates hover. */
			html:not(.sim-ready) .social-links a:hover {
				transform: scale(1.15);
				opacity: 1;
			}
			.social-links svg {
				width: 2rem;
				height: 2rem;
			}
			/* The renderer draws the icons once it's running; these stay as
			   the hit areas (and drive the hover animation it mirrors). */
			.sim-ready .social-links svg {
				opacity: 0;
			}

			button {
				font: inherit;
				color: inherit;
				background: none;
				border: 0;
				padding: 0;
				cursor: pointer;
				-webkit-user-select: none;
				user-select: none;
				touch-action: manipulation;
			}
			.sim-ui svg {
				fill: none;
				stroke: currentColor;
				stroke-width: 2;
				stroke-linecap: round;
				stroke-linejoin: round;
			}
			.sim-ui svg .fill {
				fill: currentColor;
				stroke: none;
			}
			.sim-ui button:focus-visible,
			.sim-ui a:focus-visible,
			.social-links a:focus-visible {
				outline: 2px solid #fff;
				outline-offset: 3px;
			}

			/* Hidden until the renderer is up (and forever under reduced motion,
			   where the sim never loads). */
			.sim-ui {
				display: none;
				opacity: 0;
				transition: opacity 0.5s ease;
			}
			.sim-live .sim-ui {
				display: block;
			}
			.sim-ready .sim-ui {
				opacity: 1;
			}
			/* Layout is measured at rest, with every animated transform off. */
			.measuring main > *,
			.measuring .sim-ui * {
				transform: none !important;
				transition: none !important;
			}
			.dragging .sim-ui * {
				pointer-events: none !important;
			}

			/* ---- Pause / add ---- */
			.sim-buttons {
				position: fixed;
				top: max(16px, var(--safe-top));
				right: max(16px, var(--safe-right));
				z-index: 4;
				display: flex;
				gap: 12px;
			}
			.glass-btn {
				display: grid;
				place-items: center;
				width: 46px;
				height: 46px;
				border-radius: 50%;
			}
			.glass-btn svg {
				grid-area: 1 / 1;
				width: 20px;
				height: 20px;
				stroke-width: 2.25;
				transition: transform 0.45s var(--ease-spring), opacity 0.2s ease;
			}
			.icon-play {
				opacity: 0;
				transform: scale(0.5);
			}
			.paused .icon-play {
				opacity: 1;
				transform: none;
			}
			.paused .icon-pause {
				opacity: 0;
				transform: scale(0.5);
			}

			/* Opacity, scale, and visibility are driven by the page script. */
			#add-btn {
				opacity: 0;
				visibility: hidden;
			}

			/* ---- Per-body controls (positioned every frame from JS) ----
			   Above the info card so a planet parked behind it stays editable. */
			#body-controls {
				visibility: hidden;
			}
			#body-controls > * {
				position: fixed;
				top: 0;
				left: 0;
				z-index: 3;
			}
			#body-controls > [hidden] {
				display: none;
			}

			.remove {
				display: grid;
				place-items: center;
				width: 28px;
				height: 28px;
				border-radius: 50%;
			}
			/* Bigger invisible hit area for fingers. */
			.remove::after {
				content: "";
				position: absolute;
				inset: -8px;
				border-radius: 50%;
			}
			.remove svg {
				width: 14px;
				height: 14px;
				stroke-width: 2.5;
				transition: transform 0.4s var(--ease-spring), color 0.15s ease;
			}
			.remove:hover svg {
				color: #ff6961;
			}
			.remove:active svg {
				transform: scale(0.75);
			}

			.stepper {
				display: flex;
				align-items: center;
				justify-content: space-between;
				box-sizing: border-box;
				width: 116px;
				height: 32px;
				padding: 0 2px;
			}
			.stepper button {
				display: grid;
				place-items: center;
				width: 28px;
				height: 28px;
				border-radius: 50%;
				transition: transform 0.35s var(--ease-spring), background-color 0.15s ease;
			}
			.stepper button svg {
				width: 14px;
				height: 14px;
				stroke-width: 2.4;
			}
			.stepper button:active {
				transform: scale(0.82);
				background: rgba(255, 255, 255, 0.16);
			}
			.stepper output {
				flex: 1;
				text-align: center;
				font-size: 14px;
				font-weight: 600;
				letter-spacing: -0.01em;
				font-variant-numeric: tabular-nums;
			}

			/* ---- Info card ---- */
			#sim-info {
				position: fixed;
				z-index: 2;
				left: max(12px, var(--safe-left));
				right: max(12px, var(--safe-right));
				bottom: max(12px, calc(var(--safe-bottom) + 4px));
				box-sizing: border-box;
				max-width: 400px;
				margin: 0 auto;
				padding: 20px 22px 18px;
				border-radius: 30px;
				font-size: 15px;
				line-height: 1.4;
				letter-spacing: -0.012em;
				/* Opacity, transform, and visibility are driven by the page script. */
				opacity: 0;
				visibility: hidden;
				transform-origin: 50% 100%;
			}
			#sim-info h2 {
				margin: 0 0 6px;
				font-family: var(--font-display);
				font-size: 19px;
				font-weight: 650;
				letter-spacing: -0.022em;
				line-height: 1.2;
			}
			#sim-info p {
				margin: 0;
				color: var(--label-secondary);
				text-wrap: pretty;
			}
			#sim-info .hint {
				margin-top: 14px;
				padding-top: 12px;
				border-top: 0.5px solid var(--separator);
				font-size: 13px;
				color: var(--label-tertiary);
			}

			.formula {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 16px;
				margin: 14px 0;
				color: var(--label);
				text-decoration: none;
			}
			.math {
				display: inline-flex;
				align-items: center;
				gap: 6px;
				font-family: var(--font-display);
				font-size: 20px;
				font-weight: 500;
				letter-spacing: 0;
				white-space: nowrap;
			}
			.math .op {
				color: var(--label-tertiary);
			}
			.math sub,
			.math sup {
				font-size: 0.62em;
				font-weight: 600;
				line-height: 0;
			}
			.frac {
				display: inline-flex;
				flex-direction: column;
				align-items: center;
				font-size: 16px;
				line-height: 1.15;
			}
			.frac > :first-child {
				padding: 0 3px 2px;
				border-bottom: 1.5px solid currentColor;
			}
			.frac > :last-child {
				padding-top: 2px;
			}
			.formula-label {
				font-size: 13px;
				font-weight: 500;
				color: var(--label-tertiary);
				text-align: right;
				transition: color 0.15s ease;
			}
			.formula:hover .formula-label {
				color: var(--label);
			}
		</style>
	</body>
</html>
