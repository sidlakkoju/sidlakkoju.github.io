---
// GitHub Pages serves this for any missing path.
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { name, siteUrl } from "../data/site";
---

<BaseLayout title={`Page not found · ${name}`} description="This page doesn't exist." url={siteUrl} noindex bodyClass="nf">
	<main class="nf-main">
		<p class="nf-code lg-eyebrow">404</p>
		<h1 class="nf-title">Page not found</h1>
		<p class="nf-text">The link may be broken, or the page may have moved.</p>
		<a class="lg-chip nf-home" href="/" data-glass="clear">
			<Icon name="arrow-left" size={16} />
			{name}
		</a>
	</main>
</BaseLayout>

<script>
	import "../styles/liquid-refraction.css";
	import { initLiquidRefraction } from "../scripts/liquid-refraction";
	initLiquidRefraction();
</script>

<style is:global>
	html {
		background: var(--lg-bg);
	}
	body.nf {
		margin: 0;
		background: var(--lg-bg);
		color: var(--lg-label);
		font-family: var(--lg-font-text);
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		-webkit-tap-highlight-color: transparent;
	}
</style>

<style>
	.nf-main {
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		min-height: 100vh;
		min-height: 100svh;
		padding: max(24px, var(--lg-safe-top)) max(24px, var(--lg-safe-right)) max(24px, var(--lg-safe-bottom)) max(24px, var(--lg-safe-left));
		text-align: center;
		/* A soft wash so the clear glass chip has something to refract. */
		background: radial-gradient(60% 45% at 50% 38%, rgba(31, 47, 209, 0.32), transparent 70%);
	}
	.nf-code {
		margin: 0;
	}
	.nf-title {
		margin: 8px 0 0;
		font-family: var(--lg-font-display);
		font-size: clamp(36px, 8vw, 56px);
		line-height: 1.1;
		font-weight: 700;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}
	.nf-text {
		margin: 12px 0 0;
		max-width: 32ch;
		font-size: 17px;
		line-height: 24px;
		letter-spacing: -0.4px;
		color: var(--lg-label-secondary);
		text-wrap: balance;
	}
	.nf-home {
		margin-top: 32px;
		padding: 0 16px 0 12px;
	}
</style>
